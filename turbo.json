{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "LOG_LEVEL",
    "KEYVAULT_DRIVER",
    "LOCAL_KEYVAULT_PATH",
    "API_HOST",
    "API_PORT",
    "API_BASE_URL",
    "WEB_URL",
    "CORS_ORIGINS",
    "NEXT_PUBLIC_API_BASE_URL",
    "WORKER_HEALTH_PORT",
    "WORKER_HEALTH_HOST",
    "GCP_PROJECT_ID",
    "GCP_KMS_LOCATION",
    "GCP_KMS_KEYRING",
    "GCP_KMS_KEK",
    "GCP_CREDENTIALS_JSON",
    "SEED_PAYOUT_ADDRESS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
