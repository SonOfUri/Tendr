{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "LOG_LEVEL",
    "KEYVAULT_DRIVER",
    "LOCAL_KEYVAULT_PATH",
    "API_HOST",
    "API_PORT",
    "API_BASE_URL",
    "WEB_URL",
    "CORS_ORIGINS",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_WEBAUTHN_RP_ID",
    "NEXT_PUBLIC_REOWN_PROJECT_ID",
    "WORKER_HEALTH_PORT",
    "WORKER_HEALTH_HOST",
    "GCP_PROJECT_ID",
    "GCP_KMS_LOCATION",
    "GCP_KMS_KEYRING",
    "GCP_KMS_KEK",
    "GCP_CREDENTIALS_JSON",
    "SEED_PAYOUT_ADDRESS",
    "NEAR_CLIENT_DRIVER",
    "NEAR_FAKE_SIMULATE",
    "NEAR_RPC_URL_LIVE",
    "NEAR_RPC_URL_TEST",
    "NEAR_PARENT_ACCOUNT_LIVE",
    "NEAR_PARENT_ACCOUNT_TEST",
    "INTENTS_CONTRACT_LIVE",
    "INTENTS_CONTRACT_TEST",
    "MERCHANT_ACCOUNT_CODE_HASH_LIVE",
    "MERCHANT_ACCOUNT_CODE_HASH_TEST",
    "FUNDING_DAILY_CAP_YOCTO",
    "FUNDING_PER_ACCOUNT_YOCTO",
    "MERCHANT_ACCOUNT_INITIAL_BALANCE_YOCTO",
    "MERCHANT_ACCOUNT_STORAGE_TOPUP_YOCTO",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_RP_NAME",
    "WEBAUTHN_ORIGINS",
    "MAIL_DRIVER",
    "ONECLICK_BASE_URL",
    "ONECLICK_API_KEY",
    "FEE_ACCOUNT_LIVE",
    "FEE_ACCOUNT_TEST",
    "CHECKOUT_SLIPPAGE_BPS",
    "CHECKOUT_GAS_MAX_USD",
    "TENDR_SPONSOR_LOSS_CAP_USD",
    "CHECKOUT_TOPUP_ENABLED",
    "EVM_RPC_URLS",
    "CHECKOUT_BASE_URL",
    "SCREENING_TEST_BLOCKLIST",
    "FX_PROVIDER",
    "FX_API_KEY",
    "FX_FIXED_RATES",
    "VERIFY_CHAINALYSIS_API_KEY",
    "E2E_API_HOST",
    "NEAR_FAKE_TIMELOCK_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/v1/tendr.js"],
      "env": ["TENDR_CHECKOUT_BASE_URL", "CHECKOUT_BASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
