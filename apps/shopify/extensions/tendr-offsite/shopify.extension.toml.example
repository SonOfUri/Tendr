# Reference configuration, not a registered extension. Generate an Offsite payments
# extension with Shopify CLI after approval and retain the UID assigned by Shopify.
api_version = "2026-10"

[[extensions]]
name = "Tendr"
handle = "tendr-offsite"
type = "payments_extension"
# uid = "RETAIN_THE_UID_FROM_SHOPIFY_CLI"
merchant_label = "Tendr"
buyer_label = "Pay with Tendr"
payment_session_url = "https://REPLACE_WITH_CONNECTOR_HOST/payments/session"
refund_session_url = "https://REPLACE_WITH_CONNECTOR_HOST/refunds/session"
# Replace with the countries and payment identifiers approved for Tendr.
# Empty arrays intentionally prevent deploying an invented availability claim.
supported_countries = []
supported_payment_methods = []
supports_3ds = false
supports_installments = false
supports_deferred_payments = false
test_mode_available = true

[[extensions.targeting]]
target = "payments.offsite.render"
