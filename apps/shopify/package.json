    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@tendr/config-eslint": "*",
    "eslint": "^9.25.1",
    "vite": "7.3.7",
    "vitest": "^3.1.2",
    "@react-router/dev": "7.18.5",
    "eslint-plugin-react": "7.37.5",
