generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys          ApiKey[]
  checkoutSessions CheckoutSession[]
  payments         Payment[]
  webhookEndpoints WebhookEndpoint[]
  auditEvents      AuditEvent[]
}

model ApiKey {
  id         String    @id @default(cuid())
  merchantId String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([keyPrefix])
}

model CheckoutSession {
  id                String   @id @default(cuid())
  merchantId        String
  merchantReference String
  amount            Decimal  @db.Decimal(28, 8)
  currency          String
  description       String?
  successUrl        String
  cancelUrl         String
  mode              String
  status            String
  metadata          Json     @default("{}")
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  payment  Payment?
  quotes   Quote[]

  @@unique([merchantId, merchantReference])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id                String    @id @default(cuid())
  sessionId         String    @unique
  merchantId        String
  status            String
  amount            Decimal   @db.Decimal(28, 8)
  currency          String
  mode              String
  provider          String
  providerReference String?
  failureReason     String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session  CheckoutSession @relation(fields: [sessionId], references: [id])
  merchant Merchant        @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
  @@index([status])
}

model Quote {
  id                 String   @id @default(cuid())
  sessionId          String
  sourceAsset        String
  sourceNetwork      String
  destinationAsset   String
  destinationNetwork String
  sourceAmount       Decimal  @db.Decimal(28, 8)
  destinationAmount  Decimal  @db.Decimal(28, 8)
  expiresAt          DateTime
  provider           String
  createdAt          DateTime @default(now())

  session CheckoutSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id            String    @id @default(cuid())
  merchantId    String
  url           String
  description   String?
  secretHash    String
  secretPreview String
  enabled       Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  merchant  Merchant          @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([merchantId])
}

model WebhookDelivery {
  id         String    @id @default(cuid())
  endpointId String
  eventId    String
  eventType  String
  payload    Json
  status     String
  attempts   Int       @default(0)
  nextRetryAt DateTime?
  lastError  String?
  deliveredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([endpointId, eventId])
  @@index([status, nextRetryAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  merchantId   String
  key          String
  requestHash  String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([merchantId, key])
}

model AuditEvent {
  id         String   @id @default(cuid())
  merchantId String?
  entityType String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
