// Tendr foundation schema — see docs/superpowers/specs/2026-10-23-foundation-design.md §1.
//
// Rules:
// - ids are Stripe-style `<prefix>_<ULID>` strings supplied by application code (no @default).
// - every FK between merchant-owned tables is composite: (parent_id, merchant_id[, livemode]),
//   so the database rejects cross-merchant and cross-mode links. Parents therefore carry
//   @@unique([id, merchantId]) / @@unique([id, merchantId, livemode]).
// - `events` is append-only (trigger in the foundation migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum MerchantKind {
  merchant
  integrator

  @@map("merchant_kind")
}

enum MerchantStatus {
  active
  suspended
  closed

  @@map("merchant_status")
}

enum MerchantUserRole {
  owner
  admin
  finance
  viewer

  @@map("merchant_user_role")
}

enum ApiKeyKind {
  secret
  publishable

  @@map("api_key_kind")
}

/// The platform a connection (a site linked through Connect) runs on.
enum ConnectionPlatform {
  woocommerce

  @@map("connection_platform")
}

enum AccountKeyKind {
  passkey
  fn_call
  recovery

  @@map("account_key_kind")
}

enum PayoutMode {
  wallet
  intents

  @@map("payout_mode")
}

enum AllowlistStatus {
  pending
  active
  revoked

  @@map("allowlist_status")
}

enum PaymentLinkNoteMode {
  off
  optional

  @@map("payment_link_note_mode")
}

enum PaymentLinkStatus {
  active
  inactive
  expired

  @@map("payment_link_status")
}

enum GasSponsor {
  default
  merchant
  buyer

  @@map("gas_sponsor")
}

enum ResolvedGasSponsor {
  merchant
  buyer

  @@map("resolved_gas_sponsor")
}

enum AmountMode {
  EXACT_IN
  EXACT_OUT

  @@map("amount_mode")
}

enum Delivery {
  WEBHOOK
  HOOK

  @@map("delivery")
}

enum FeePayer {
  merchant
  payer

  @@map("fee_payer")
}

enum SessionStatus {
  PENDING_DEPOSIT
  PROCESSING
  SETTLED
  REFUNDED
  EXPIRED
  LATE_DEPOSIT
  HELD
  SCREENING_PENDING

  @@map("session_status")
}

/// Why a session is EXPIRED: its lifetime ran out, or the store canceled it.
enum SessionExpiredReason {
  timeout
  canceled

  @@map("session_expired_reason")
}

enum PaymentStatus {
  DETECTED
  PROCESSING
  SETTLED
  REFUNDING
  REFUNDED
  HELD
  SCREENING_PENDING
  /// Settled, then part of it returned by a merchant-initiated refund that executed.
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

/// Where 1Click delivers a session's swap output (`recipientType` of the 1Click request).
enum RecipientType {
  INTENTS
  DESTINATION_CHAIN

  @@map("recipient_type")
}

/// Where 1Click sends refunds for a quote (`refundType` of the 1Click request).
enum QuoteRefundType {
  ORIGIN_CHAIN
  INTENTS

  @@map("quote_refund_type")
}

/// Why a payment is HELD.
enum HeldReason {
  sanctions
  screening_unavailable

  @@map("held_reason")
}

enum RefundReason {
  expired
  late
  underpaid
  failed
  overpaid
  sanctions
  /// A refund the store started (`POST /v1/refunds`): several per payment, keyed by `external_ref`.
  merchant

  @@map("refund_reason")
}

enum ExternalTxStatus {
  pending
  submitted
  confirmed
  failed

  @@map("external_tx_status")
}

enum SponsorshipMethod {
  eip3009
  permit
  paymaster
  paymaster_verifying
  paymaster_erc20
  energy
  fee_payer
  /// The Tendr payment forwarder (EIP-2612 permit, or Tron exact approve, + signed TendrPayment).
  forwarder
  /// NEAR NEP-366 meta-transaction (signed delegate action) relayed by `relayer-near`.
  meta_tx
  /// Pimlico's Solana paymaster (Kora).
  kora
  /// An integrator hook call (`onTendrDeposit`) whose actual gas exceeded the quoted hook estimate:
  /// the shortfall, recognised as Tendr's loss (`cost_usd` is the shortfall, not the whole cost).
  hook

  @@map("sponsorship_method")
}

/// How a shopper-paid network fee is paid: in the payment token (gasless) or the chain's coin.
enum FeeMode {
  token
  native

  @@map("fee_mode")
}

/// A sponsorship's hold on the merchant's monthly gas budget.
enum GasReservationState {
  reserved
  settled
  released

  @@map("gas_reservation_state")
}

enum Sponsor {
  merchant
  tendr
  /// A relayed payment whose network fee the shopper paid in the payment token (project 5a).
  shopper

  @@map("sponsor")
}

enum ScreeningDecision {
  allow
  block

  @@map("screening_decision")
}

enum RevenueSource {
  app_fee
  spread
  oneclick_fee
  network_fee
  gas_reimbursement

  @@map("revenue_source")
}

enum ThemeStatus {
  draft
  published

  @@map("theme_status")
}

enum ProductImageStatus {
  pending
  ok
  failed

  @@map("product_image_status")
}

enum ThemeAssetKind {
  logo
  image
  font

  @@map("theme_asset_kind")
}

enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

enum WebauthnChallengePurpose {
  registration
  authentication
  /// A recovery-kit sign-in (lost all passkeys): the store's recovery key signs it.
  recovery_session

  @@map("webauthn_challenge_purpose")
}

enum EmailTokenPurpose {
  verify
  login
  invite
  /// The mailbox half of a recovery-kit passkey registration (R28): sent when a restricted
  /// recovery session opens; registering needs it AND the kit session.
  recovery_register

  @@map("email_token_purpose")
}

enum MerchantAccountStatus {
  provisioning
  active
  failed

  @@map("merchant_account_status")
}

/// The contract's `Action` variants in snake_case, in Borsh order (see @tendr/contracts).
enum ProposalKind {
  add_signer
  remove_signer
  add_signer_key
  remove_signer_key
  set_threshold
  set_origins
  rotate_recovery_key
  add_saved_address
  remove_saved_address
  set_limits
  set_refund_cap
  set_auto_sweep
  clear_auto_sweep
  withdraw
  refund
  upgrade
  set_settlement

  @@map("proposal_kind")
}

enum ProposalStatus {
  draft
  pending
  timelocked
  executing
  executed
  cancelled
  expired
  failed

  @@map("proposal_status")
}

enum RecoveryStatus {
  pending
  cancelled
  executed
  failed

  @@map("recovery_status")
}

// ─── People (global; not owned by a merchant) ───────────────────────────────

/// A person. `id` (`per_…`) is also their signer id on merchant account contracts.
/// `email` is stored lower-cased (CHECK users_email_lowercase).
model User {
  id              String    @id
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships       MerchantUser[]
  credentials       WebauthnCredential[]
  dashboardSessions DashboardSession[]
  challenges        WebauthnChallenge[]
  accountKeys       AccountKey[]
  proposals         AccountProposal[]
  approvals         AccountApproval[]
  connections       Connection[]

  @@map("users")
}

/// A passkey. An active `public_key` is unique (a partial unique index in migration
/// 20261025170000_dashboard_auth_hardening; Prisma cannot express it).
/// `public_key` is the contract's `SignerKey` JSON:
/// `{ "p256": "<base64 33-byte compressed SEC1>" }` or `{ "ed25519": "<base64 32 bytes>" }`.
model WebauthnCredential {
  id           String    @id
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Json      @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]
  deviceLabel  String?   @map("device_label")
  lastUsedAt   DateTime? @map("last_used_at")
  /// Set when the person removes the passkey. A revoked credential never logs in, is never offered
  /// in `allowCredentials` and never approves. Rows are kept: approvals reference them.
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals   AccountApproval[]
  accountKeys AccountKey[]

  // Lets approvals and account keys pin a credential to its owner (composite FKs).
  @@unique([id, userId])
  @@index([userId])
  @@map("webauthn_credentials")
}

/// A dashboard login. Sliding expiry: each use moves `expires_at` (default 30 days).
model DashboardSession {
  id                 String    @id
  userId             String    @map("user_id")
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  lastUsedAt         DateTime? @map("last_used_at")
  /// When this session last proved a passkey (login, first registration, step-up). Sensitive
  /// actions need it within the last 10 minutes.
  passkeyVerifiedAt  DateTime? @map("passkey_verified_at")
  /// Set on a RESTRICTED session opened with the store's recovery kit (lost all passkeys): it may
  /// only register a passkey for its person and start a recovery of this store; every other route
  /// refuses it. Plain column (no FK): sessions are identity rows, outside tenant scoping.
  recoveryMerchantId String?   @map("recovery_merchant_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("dashboard_sessions")
}

/// One-time email links (verify, login, invite). `email` is lower-cased.
model EmailToken {
  id         String            @id
  email      String
  purpose    EmailTokenPurpose
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at")
  consumedAt DateTime?         @map("consumed_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_tokens")
}

/// Server-issued WebAuthn ceremony challenges (passkey registration and login): random, single-use,
/// valid 5 minutes. Only `sha256(challenge)` is stored. Proposal approvals never use these: their
/// challenge is the 32-byte payload hash, while these carry a fixed tag and are longer.
model WebauthnChallenge {
  id            String                   @id
  purpose       WebauthnChallengePurpose
  challengeHash String                   @unique @map("challenge_hash")
  /// The person registering (registration only); login challenges are not bound to a person.
  userId        String?                  @map("user_id")
  expiresAt     DateTime                 @map("expires_at")
  consumedAt    DateTime?                @map("consumed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ─── Merchant domain ────────────────────────────────────────────────────────

model Merchant {
  id                              String             @id
  name                            String
  slug                            String             @unique
  kind                            MerchantKind       @default(merchant)
  aupAcceptedAt                   DateTime?          @map("aup_accepted_at")
  status                          MerchantStatus     @default(active)
  /// Origins allowed to frame the checkout (CSP `frame-ancestors`); shared by both modes.
  checkoutDomains                 String[]           @default([]) @map("checkout_domains")
  defaultFeePayer                 FeePayer           @default(merchant) @map("default_fee_payer")
  defaultGasPayer                 ResolvedGasSponsor @default(buyer) @map("default_gas_payer")
  /// The verified address for the store's payment and refund notices; null → the owners' emails.
  notificationEmail               String?            @map("notification_email")
  /// An address waiting for its verify link (only ever mailed that link). Set together with the
  /// token hash, its expiry and the request (who asked, in which mode): all four or none.
  notificationEmailPending        String?            @map("notification_email_pending")
  /// sha256 (hex) of the single-use verify token; a new request replaces it.
  notificationEmailTokenHash      String?            @unique @map("notification_email_token_hash")
  notificationEmailTokenExpiresAt DateTime?          @map("notification_email_token_expires_at")
  /// `{ by: 'user', userId } | { by: 'connection', connectionId }` plus `livemode`.
  notificationEmailRequest        Json?              @map("notification_email_request")
  /// The raw verify token, KeyVault-encrypted (`secrets`), until the link mail is sent; then null.
  notificationEmailLinkSecretRef  String?            @map("notification_email_link_secret_ref")
  /// The "You got paid" email; refund notices are always sent.
  paymentEmailsEnabled            Boolean            @default(true) @map("payment_emails_enabled")
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")

  users                       MerchantUser[]
  apiKeys                     ApiKey[]
  accountKeys                 AccountKey[]
  settlementConfigs           SettlementConfig[]
  payoutAllowlist             PayoutAllowlistEntry[]
  webhookEndpoints            WebhookEndpoint[]
  gasPolicies                 GasPolicy[]
  gasBudgetMonths             GasBudgetMonth[]
  paymentLinks                PaymentLink[]
  sessions                    Session[]
  quotes                      Quote[]
  payments                    Payment[]
  refunds                     Refund[]
  webhookDeliveries           WebhookDelivery[]
  hookCalls                   HookCall[]
  gasSponsorships             GasSponsorship[]
  screeningResults            ScreeningResult[]
  events                      Event[]
  feePlans                    FeePlan[]
  revenueEntries              RevenueEntry[]
  settlementClaims            SettlementClaim[]
  checkoutThemes              CheckoutTheme[]
  themeAssets                 ThemeAsset[]
  productImages               ProductImage[]
  idempotencyKeys             IdempotencyKey[]
  invites                     MerchantInvite[]
  merchantAccounts            MerchantAccount[]
  accountProposals            AccountProposal[]
  accountApprovals            AccountApproval[]
  recoveryRequests            RecoveryRequest[]
  accountLimits               AccountLimit[]
  connections                 Connection[]
  notificationEmailLinkSecret Secret?                @relation("NotificationEmailLinkSecret", fields: [notificationEmailLinkSecretRef], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("merchants")
}

/// A person's membership of a merchant (prefix `usr`). `is_signer` mirrors whether the person
/// is a signer on the merchant's account contracts.
model MerchantUser {
  id         String           @id
  merchantId String           @map("merchant_id")
  userId     String           @map("user_id")
  role       MerchantUserRole
  isSigner   Boolean          @default(false) @map("is_signer")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([merchantId, userId])
  @@index([userId])
  @@map("merchant_users")
}

/// An invitation to join a merchant. `email` is lower-cased; the raw token is never stored.
model MerchantInvite {
  id         String           @id
  merchantId String           @map("merchant_id")
  email      String
  role       MerchantUserRole
  makeSigner Boolean          @default(false) @map("make_signer")
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_invites")
}

model ApiKey {
  id               String     @id
  merchantId       String     @map("merchant_id")
  livemode         Boolean
  name             String
  kind             ApiKeyKind
  keyPrefix        String     @map("key_prefix")
  keyHash          String     @unique @map("key_hash")
  scopes           String[]
  signingSecretRef String?    @map("signing_secret_ref")
  signingRequired  Boolean    @default(false) @map("signing_required")
  /// Set on a connection key (ruling W1: a `secret_key` / publishable key issued by Connect for
  /// one site). Null for keys the store created by hand.
  connectionId     String?    @map("connection_id")
  lastUsedAt       DateTime?  @map("last_used_at")
  revokedAt        DateTime?  @map("revoked_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  merchant      Merchant    @relation(fields: [merchantId], references: [id])
  signingSecret Secret?     @relation(fields: [signingSecretRef], references: [id], onDelete: Restrict)
  connection    Connection? @relation(fields: [connectionId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([connectionId])
  @@map("api_keys")
}

/// A public key registered on a merchant account contract. `user_id` is null for the recovery
/// key; `credential_id`, when set, must be a passkey of that same person (composite FK).
model AccountKey {
  id            String         @id
  merchantId    String         @map("merchant_id")
  livemode      Boolean
  nearAccountId String         @map("near_account_id")
  publicKey     String         @map("public_key")
  kind          AccountKeyKind
  userId        String?        @map("user_id")
  credentialId  String?        @map("credential_id")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant   Merchant            @relation(fields: [merchantId], references: [id])
  user       User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credential WebauthnCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([userId])
  @@map("account_keys")
}

// ─── Merchant accounts (on-chain threshold contracts) ───────────────────────

/// The merchant's NEAR account for one mode. Postgres mirrors the contract; the contract is
/// authoritative. Replaces the idea of `merchants.near_account_id`.
model MerchantAccount {
  id                 String                @id
  merchantId         String                @map("merchant_id")
  livemode           Boolean
  nearAccountId      String                @unique @map("near_account_id")
  contractCodeHash   String?               @map("contract_code_hash")
  threshold          Int
  signerEpoch        BigInt                @default(0) @map("signer_epoch")
  status             MerchantAccountStatus @default(provisioning)
  createdTx          String?               @map("created_tx")
  /// The provisioning attempt holding the row (see accounts/accounts.ts): set with
  /// `provision_claimed_at` when an attempt claims it, cleared when that attempt ends. A claim
  /// older than the lease (5 minutes) is stale and may be taken over.
  provisionAttemptId String?               @map("provision_attempt_id")
  provisionClaimedAt DateTime?             @map("provision_claimed_at")
  /// Reconciliation cursor: how many on-chain proposals (`list_proposals`, creation order, never
  /// removed) the watcher has read. Open ones are re-read by id.
  proposalsSeen      Int                   @default(0) @map("proposals_seen")
  /// Mirror of the contract's `recovery_key_epoch` (`get_config`); recovery payloads sign it.
  recoveryKeyEpoch   BigInt?               @map("recovery_key_epoch")
  reconciledAt       DateTime?             @map("reconciled_at")
  /// Set while a storage top-up is blocked by the funding daily cap (R35); the dashboard warns
  /// while it is set. Cleared once the account has enough free balance again.
  storageLowAt       DateTime?             @map("storage_low_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  proposals        AccountProposal[]
  recoveryRequests RecoveryRequest[]
  limits           AccountLimit[]

  @@unique([merchantId, livemode])
  @@unique([id, merchantId, livemode])
  @@map("merchant_accounts")
}

/// A proposal on the account contract. `onchain_id` is the 32-byte proposal id as lower-case hex
/// (sha256(borsh(action) ‖ salt)); `salt` is base64; `action` is the contract `Action` JSON.
model AccountProposal {
  id              String         @id
  merchantId      String         @map("merchant_id")
  livemode        Boolean
  accountId       String         @map("account_id")
  onchainId       String         @map("onchain_id")
  kind            ProposalKind
  action          Json
  salt            String
  status          ProposalStatus @default(draft)
  /// Null when the proposal was first seen on chain and its creator is not a known person.
  createdByUserId String?        @map("created_by_user_id")
  readyAt         DateTime?      @map("ready_at")
  executedAt      DateTime?      @map("executed_at")
  lastTxHash      String?        @map("last_tx_hash")
  /// Set while a signer's first approval of a draft is being relayed (`propose`): a claim that
  /// stops a local draft cancel from racing the relay. Cleared when the relay ends; a claim older
  /// than the lease (2 minutes) is stale and may be taken over.
  relayClaimedAt  DateTime?      @map("relay_claimed_at")
  /// An expired proposal holds its creator's pending slot on chain until `execute` marks it
  /// expired there. Set once the executor job settled it (I3).
  expirySettledAt DateTime?      @map("expiry_settled_at")
  /// For a system-drafted `refund` proposal: the refund it returns (exact back-link, set once).
  refundId        String?        @map("refund_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  merchant  Merchant          @relation(fields: [merchantId], references: [id])
  account   MerchantAccount   @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals AccountApproval[]
  refunds   Refund[]

  @@unique([accountId, onchainId])
  @@unique([id, merchantId, livemode])
  @@index([merchantId, livemode, status])
  @@index([refundId])
  @@map("account_proposals")
}

/// One signer's approval of a proposal, with the passkey and signer epoch it was made under.
/// The contract keeps at most one approval per signer (re-approving replaces it), so this does too.
model AccountApproval {
  id           String   @id
  merchantId   String   @map("merchant_id")
  livemode     Boolean
  proposalId   String   @map("proposal_id")
  userId       String   @map("user_id")
  credentialId String   @map("credential_id")
  signerEpoch  BigInt   @map("signer_epoch")
  txHash       String?  @map("tx_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant   Merchant           @relation(fields: [merchantId], references: [id])
  proposal   AccountProposal    @relation(fields: [proposalId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credential WebauthnCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([proposalId, userId])
  @@index([merchantId])
  @@index([userId])
  @@map("account_approvals")
}

/// A recovery started with the recovery key: replaces the signer set after 72 h unless a signer
/// cancels. `onchain_id` is the contract's recovery id (hex) once started.
model RecoveryRequest {
  id               String         @id
  merchantId       String         @map("merchant_id")
  livemode         Boolean
  accountId        String         @map("account_id")
  onchainId        String?        @map("onchain_id")
  executesAt       DateTime       @map("executes_at")
  status           RecoveryStatus @default(pending)
  newSignerIds     String[]       @map("new_signer_ids")
  newThreshold     Int?           @map("new_threshold")
  nonce            BigInt?
  /// The recovery-key epoch the recovery was started under (part of its id).
  recoveryKeyEpoch BigInt?        @map("recovery_key_epoch")
  startTxHash      String?        @map("start_tx_hash")
  cancelTxHash     String?        @map("cancel_tx_hash")
  executeTxHash    String?        @map("execute_tx_hash")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  account  MerchantAccount @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, onchainId])
  @@index([merchantId, livemode, status])
  @@map("recovery_requests")
}

/// Mirror of the contract's per-asset limits, refund cap and auto-sweep rule (`get_limits`,
/// `get_auto_sweep`). Amounts are the asset's smallest units. Display and fast validation only.
model AccountLimit {
  id                  String   @id
  merchantId          String   @map("merchant_id")
  livemode            Boolean
  accountId           String   @map("account_id")
  asset               String
  perTx               Decimal? @map("per_tx") @db.Decimal(78, 0)
  perDay              Decimal? @map("per_day") @db.Decimal(78, 0)
  refundCap           Decimal? @map("refund_cap") @db.Decimal(78, 0)
  sweepTriggerAbove   Decimal? @map("sweep_trigger_above") @db.Decimal(78, 0)
  sweepKeep           Decimal? @map("sweep_keep") @db.Decimal(78, 0)
  sweepSavedAddressId String?  @map("sweep_saved_address_id")
  sweepChain          String?  @map("sweep_chain")
  sweepAddress        String?  @map("sweep_address")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  account  MerchantAccount @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, asset])
  @@index([merchantId, livemode])
  @@map("account_limits")
}

// ─── Configuration ──────────────────────────────────────────────────────────

model SettlementConfig {
  id            String     @id
  merchantId    String     @map("merchant_id")
  livemode      Boolean
  destAssetId   String     @map("dest_asset_id")
  destChain     String     @map("dest_chain")
  payoutMode    PayoutMode @map("payout_mode")
  payoutAddress String?    @map("payout_address")
  nearAccount   String?    @map("near_account")
  isDefault     Boolean    @default(false) @map("is_default")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("settlement_configs")
}

model PayoutAllowlistEntry {
  id         String          @id
  merchantId String          @map("merchant_id")
  livemode   Boolean
  chain      String
  address    String
  status     AllowlistStatus @default(pending)
  activeFrom DateTime        @map("active_from")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  // (merchant_id, livemode, chain, address) is unique among non-revoked rows only (a partial
  // unique index in migration 20261025220000_chain_watcher): a removed address may be re-added
  // under a new on-chain id.
  @@index([merchantId, livemode])
  @@map("payout_allowlist")
}

model WebhookEndpoint {
  id                      String    @id
  merchantId              String    @map("merchant_id")
  livemode                Boolean
  url                     String
  secretRef               String    @map("secret_ref")
  /// The secret replaced by the last rotation; it still signs (a second v1=) until the expiry.
  previousSecretRef       String?   @map("previous_secret_ref")
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at")
  events                  String[]
  active                  Boolean   @default(true)
  /// Set on an endpoint created by Connect for one site; it receives only that connection's
  /// events: those whose session was created with its keys (webhooks.ts `fanOutEvent`). Null: a
  /// hand-made endpoint, which receives every event of its store and mode.
  connectionId            String?   @map("connection_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  secret     Secret            @relation(fields: [secretRef], references: [id])
  connection Connection?       @relation(fields: [connectionId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  deliveries WebhookDelivery[]

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([connectionId])
  @@map("webhook_endpoints")
}

model GasPolicy {
  id               String   @id
  merchantId       String   @map("merchant_id")
  livemode         Boolean
  enabled          Boolean  @default(false)
  perPaymentCapUsd Decimal  @map("per_payment_cap_usd") @db.Decimal(18, 6)
  monthlyBudgetUsd Decimal  @map("monthly_budget_usd") @db.Decimal(18, 6)
  minOrderUsd      Decimal  @map("min_order_usd") @db.Decimal(18, 6)
  chains           String[]
  tokens           String[]
  firstTimeOnly    Boolean  @default(false) @map("first_time_only")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, livemode])
  @@index([merchantId])
  @@map("gas_policies")
}

/// A merchant's gas budget use for one calendar month (UTC) in one mode (spec 5a §2.2).
/// `reservedUsd` is held by sponsorships not yet settled, `spentUsd` is settled; a reservation
/// only succeeds while reserved + spent + the new amount stays within the policy's budget.
model GasBudgetMonth {
  id          String   @id
  merchantId  String   @map("merchant_id")
  livemode    Boolean
  /// `YYYY-MM`
  month       String
  reservedUsd Decimal  @default(0) @map("reserved_usd") @db.Decimal(18, 6)
  spentUsd    Decimal  @default(0) @map("spent_usd") @db.Decimal(18, 6)
  /// Sponsorships charged to this month (reserved or settled).
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, livemode, month])
  @@map("gas_budget_months")
}

// ─── Payments core ──────────────────────────────────────────────────────────

model PaymentLink {
  id                    String              @id
  merchantId            String              @map("merchant_id")
  livemode              Boolean
  themeId               String?             @map("theme_id")
  /// Optional Intents asset override; null inherits the store's settlement configuration.
  settlementAssetId     String?             @map("settlement_asset_id")
  /// Display metadata from the provider when the override was selected, not a destination.
  settlementAssetSymbol String?             @map("settlement_asset_symbol")
  settlementAssetChain  String?             @map("settlement_asset_chain")
  slug                  String
  title                 String
  amount                Decimal?            @db.Decimal(38, 18)
  amountCurrency        String              @map("amount_currency")
  openAmount            Boolean             @default(false) @map("open_amount")
  description           String?
  /// Open links only: the lowest amount the payer may enter, in `amountCurrency`.
  minAmount             Decimal?            @map("min_amount") @db.Decimal(38, 18)
  noteMode              PaymentLinkNoteMode @default(optional) @map("note_mode")
  /// Null = the merchant's default fee payer.
  feePayer              FeePayer?           @map("fee_payer")
  archivedAt            DateTime?           @map("archived_at")
  gasSponsor            GasSponsor          @default(default) @map("gas_sponsor")
  gasMaxUsd             Decimal?            @map("gas_max_usd") @db.Decimal(18, 6)
  maxUses               Int?                @map("max_uses")
  useCount              Int                 @default(0) @map("use_count")
  expiresAt             DateTime?           @map("expires_at")
  status                PaymentLinkStatus   @default(active)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  theme    CheckoutTheme? @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  sessions Session[]

  @@unique([id, merchantId, livemode])
  @@unique([merchantId, livemode, slug])
  @@map("payment_links")
}

model Session {
  id               String                @id
  merchantId       String                @map("merchant_id")
  livemode         Boolean
  themeId          String?               @map("theme_id")
  paymentLinkId    String?               @map("payment_link_id")
  externalRef      String?               @map("external_ref")
  amountMode       AmountMode            @map("amount_mode")
  amount           Decimal               @db.Decimal(38, 18)
  amountCurrency   String                @map("amount_currency")
  destAsset        String                @map("dest_asset")
  destChain        String                @map("dest_chain")
  recipient        String
  /// Pinned at creation: `INTENTS` (recipient is the merchant account) or `DESTINATION_CHAIN`
  /// (recipient is the saved payout address, wallet mode).
  recipientType    RecipientType         @default(INTENTS) @map("recipient_type")
  /// The merchant's intents account at creation: the `INTENTS` refund destination for manual
  /// sends without a refund address (equals `recipient` in intents payout mode).
  intentsAccount   String?               @map("intents_account")
  beneficiary      String?
  delivery         Delivery
  hookData         Json?                 @map("hook_data")
  metadata         Json                  @default("{}")
  feeBps           Int                   @map("fee_bps")
  feePayer         FeePayer              @map("fee_payer")
  /// Free-text note from the payer (payment links), cleaned by `cleanPayerNote`.
  payerNote        String?               @map("payer_note") @db.VarChar(280)
  /// The resolved gas payer (API `gas_payer`; `buyer` is the shopper).
  gasSponsor       ResolvedGasSponsor    @map("gas_sponsor")
  gasMaxUsd        Decimal?              @map("gas_max_usd") @db.Decimal(18, 6)
  status           SessionStatus         @default(PENDING_DEPOSIT)
  expiresAt        DateTime              @map("expires_at")
  clientSecretHash String                @unique @map("client_secret_hash")
  successUrl       String?               @map("success_url")
  cancelUrl        String?               @map("cancel_url")
  /// Lower-cased (CHECK in migration checkout_core); refund contact and receipts only.
  customerEmail    String?               @map("customer_email")
  expiredReason    SessionExpiredReason? @map("expired_reason")
  /// The connection whose key created the session (from `api_keys.connection_id`); null for
  /// sessions created with a hand-made key, a payment link or the dashboard.
  connectionId     String?               @map("connection_id")
  /// A non-USD order total converted to USD at creation (`amount` is then the USD amount, rounded
  /// up to the cent). `fxRate` reads "1 USD = fxRate <originalCurrency>"; `fxAsOf` is the rate's
  /// own timestamp from `fxSource`. All null for USD and settlement-asset sessions (CHECK in
  /// migration session_fx).
  originalAmount   Decimal?              @map("original_amount") @db.Decimal(38, 18)
  originalCurrency String?               @map("original_currency")
  fxRate           Decimal?              @map("fx_rate") @db.Decimal(38, 18)
  fxSource         String?               @map("fx_source")
  fxAsOf           DateTime?             @map("fx_as_of")
  /// Cart lines shown on the checkout page (validated `LineItem[]`, max 50).
  lineItems        Json?                 @map("line_items")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  connection        Connection?       @relation(fields: [connectionId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  /// The DB constraint is `ON DELETE SET NULL (theme_id)` (migration 20261030130000); Prisma cannot express the column list.
  theme             CheckoutTheme?    @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  paymentLink       PaymentLink?      @relation(fields: [paymentLinkId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  quotes            Quote[]
  payments          Payment[]
  webhookDeliveries WebhookDelivery[]
  hookCalls         HookCall[]
  gasSponsorships   GasSponsorship[]
  screeningResults  ScreeningResult[]

  // (merchant_id, livemode, external_ref) is unique only among PENDING_DEPOSIT, PROCESSING,
  // SCREENING_PENDING and SETTLED sessions (a partial unique index in migration checkout_core):
  // an expired, late or held order may get a new session.
  @@unique([id, merchantId, livemode])
  @@index([status, expiresAt])
  @@index([connectionId])
  @@map("sessions")
}

model Quote {
  id                   String              @id
  merchantId           String              @map("merchant_id")
  livemode             Boolean
  sessionId            String              @map("session_id")
  originAssetId        String              @map("origin_asset_id")
  depositAddress       String              @map("deposit_address")
  amountIn             Decimal             @map("amount_in") @db.Decimal(78, 0)
  amountOut            Decimal             @map("amount_out") @db.Decimal(78, 0)
  refundTo             String              @map("refund_to")
  deadline             DateTime
  oneclickQuoteRef     String?             @map("oneclick_quote_ref")
  /// Set when a newer quote replaced this one for the session.
  supersededAt         DateTime?           @map("superseded_at")
  amountInUsd          Decimal?            @map("amount_in_usd") @db.Decimal(18, 6)
  /// 1Click's USD value of `amount_out` at quote time (the shopper's fee line is in − out).
  amountOutUsd         Decimal?            @map("amount_out_usd") @db.Decimal(18, 6)
  /// How 1Click returns money for this quote: to `refund_to` on the origin chain (direct), or
  /// into the merchant's intents account (`INTENTS`, signer-approved return-to-sender).
  refundType           QuoteRefundType?    @map("refund_type")
  /// The shopper reported a deposit transaction for this quote (`POST …/client/deposit`).
  depositTxHash        String?             @map("deposit_tx_hash")
  depositTxSubmittedAt DateTime?           @map("deposit_tx_submitted_at")
  /// The payment watcher: when the next 1Click status poll is due (also a running poll's claim
  /// lease). A partial index (migration payment_watcher) covers rows still being watched.
  watchNextAt          DateTime?           @map("watch_next_at")
  /// Polling stopped for good (terminal payment, 24 h after creation, or a superseded quote past
  /// its deadline + 30 min with no deposit).
  watchStoppedAt       DateTime?           @map("watch_stopped_at")
  /// When the last poll of this address completed (the expiry sweep waits for one after expiry).
  watchPolledAt        DateTime?           @map("watch_polled_at")
  /// Who pays the network fee (spec §2.6): `merchant` (sponsored) or `buyer` (the shopper). Null
  /// on quotes made before gasless payments.
  networkFeePaidBy     ResolvedGasSponsor? @map("network_fee_paid_by")
  /// Shopper pays: in the payment token (`token`, gasless) or the chain's coin (`native`). Null
  /// when the merchant sponsors.
  networkFeeMode       FeeMode?            @map("network_fee_mode")
  /// The quoted network fee (USD): with Tendr's margin when Tendr collects it (sponsored, or the
  /// shopper's token fee); the shopper's own estimate for a native send.
  networkFeeUsd        Decimal?            @map("network_fee_usd") @db.Decimal(18, 6)
  /// Shopper-paid token fee: base units of the origin asset, sent on top of `amount_in`.
  networkFeeAmount     Decimal?            @map("network_fee_amount") @db.Decimal(78, 0)
  /// The gasless method the fee was quoted for; null for a native (copy-address or wallet) send.
  networkFeeMethod     SponsorshipMethod?  @map("network_fee_method")
  /// Why the shopper pays (`shopper_choice`, `budget`, …); null when the merchant sponsors.
  networkFeeReason     String?             @map("network_fee_reason")
  /// Basis points added to Tendr's 1Click `appFees` to collect the merchant-sponsored fee and the
  /// integrator hook estimate from the merchant's proceeds (recorded as `gas_reimbursement`).
  networkFeeBps        Int                 @default(0) @map("network_fee_bps")
  /// The integrator hook call's estimated cost (USD), deducted from the merchant's proceeds.
  hookFeeUsd           Decimal?            @map("hook_fee_usd") @db.Decimal(18, 6)
  /// The budget reservation for a merchant-sponsored fee (released when the quote is replaced or
  /// expires unused).
  gasSponsorshipId     String?             @map("gas_sponsorship_id")
  /// The connected wallet the quote was made for (`wallet_address`): the only address whose
  /// signatures the relayer accepts for this quote. Null for a copy-address quote.
  walletAddress        String?             @map("wallet_address")
  /// SHA-256 (hex) of the quote's paymaster URL token (`/v1/checkout/paymaster/:token`, method
  /// `paymaster`): the URL a smart wallet calls for sponsorship of exactly this quote's calls.
  /// Requests are looked up by this hash.
  paymasterTokenHash   String?             @unique @map("paymaster_token_hash")
  /// The token itself as a stored secret (`secrets`, envelope-encrypted, purpose `paymaster-url`),
  /// so a repeated gasless/prepare returns the same URL instead of minting a new one.
  paymasterTokenRef    String?             @map("paymaster_token_ref")
  createdAt            DateTime            @default(now()) @map("created_at")

  merchant          Merchant         @relation(fields: [merchantId], references: [id])
  session           Session          @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  gasSponsorship    GasSponsorship?  @relation("QuoteReservation", fields: [gasSponsorshipId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  /// Relayed submissions of this quote (gasless payments).
  relaySponsorships GasSponsorship[] @relation("RelayedQuote")
  payments          Payment[]

  // Lets payments pin their quote to the same session (payments FK below).
  @@unique([id, sessionId, merchantId, livemode])
  @@unique([livemode, depositAddress])
  @@index([merchantId])
  @@index([sessionId])
  @@index([gasSponsorshipId])
  @@map("quotes")
}

model Payment {
  id                    String        @id
  merchantId            String        @map("merchant_id")
  livemode              Boolean
  sessionId             String        @map("session_id")
  /// One payment per deposit address (quote).
  quoteId               String        @unique(map: "payments_quote_id_key") @map("quote_id")
  originTxHash          String?       @map("origin_tx_hash")
  amountReceived        Decimal       @map("amount_received") @db.Decimal(78, 0)
  settleTx              String?       @map("settle_tx")
  payoutTx              String?       @map("payout_tx")
  feeAmount             Decimal?      @map("fee_amount") @db.Decimal(78, 0)
  networkFee            Decimal?      @map("network_fee") @db.Decimal(78, 0)
  gasSponsored          Boolean       @default(false) @map("gas_sponsored")
  status                PaymentStatus @default(DETECTED)
  isLate                Boolean       @default(false) @map("is_late")
  senderAddress         String?       @map("sender_address")
  /// Every sender found (several for a multi-input Bitcoin deposit); each is screened.
  senderAddresses       String[]      @default([]) @map("sender_addresses")
  /// Origin transactions whose senders were resolved and screened; settlement needs all of them.
  senderOriginHashes    String[]      @default([]) @map("sender_origin_hashes")
  /// Refund reasons already recorded (`payment.refunded` and the return happen once per reason).
  refundsRecorded       String[]      @default([]) @map("refunds_recorded")
  senderChain           String?       @map("sender_chain")
  overpaidAmount        Decimal?      @map("overpaid_amount") @db.Decimal(78, 0)
  refundedAmount        Decimal?      @map("refunded_amount") @db.Decimal(78, 0)
  /// The last 1Click status seen for this payment's quote.
  oneclickStatus        String?       @map("oneclick_status")
  heldReason            HeldReason?   @map("held_reason")
  /// The overpayment was worth less than SMALL_OVERPAY_USD and stays with the merchant.
  keptSmallOverpayment  Boolean       @default(false) @map("kept_small_overpayment")
  /// The return reasons kept by the merchant because they were worth less than SMALL_OVERPAY_USD
  /// net of the return fee. Decided per reason: keeping one return never keeps another (C40).
  keptSmallReasons      String[]      @default([]) @map("kept_small_reasons")
  amountOut             Decimal?      @map("amount_out") @db.Decimal(78, 0)
  amountInUsd           Decimal?      @map("amount_in_usd") @db.Decimal(18, 6)
  settledAt             DateTime?     @map("settled_at")
  /// How the settlement transfer (`settle_tx`; the claimed event is in `settlement_claims`) was verified:
  /// `receipt` (its transfer event) or `oneclick` (wallet payout to a chain without a verifier).
  verifiedBy            String?       @map("verified_by")
  /// Sanctions-screening retries done while SCREENING_PENDING.
  screeningAttempts     Int           @default(0) @map("screening_attempts")
  /// When the next screening retry is due; null = first retry (1 min after creation).
  screeningNextAt       DateTime?     @map("screening_next_at")
  /// Set when screening was still unavailable after 6 h: a merchant review item (not a hold).
  screeningUnresolvedAt DateTime?     @map("screening_unresolved_at")
  /// The typed legal-clearance acknowledgement (owner, step-up) for a held payment: required
  /// before its funds can be returned. `legal_ack_by_user_id` is the person (no FK: a record).
  legalAckAt            DateTime?     @map("legal_ack_at")
  legalAckByUserId      String?       @map("legal_ack_by_user_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  merchant                 Merchant          @relation(fields: [merchantId], references: [id])
  session                  Session           @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  quote                    Quote             @relation(fields: [quoteId, sessionId, merchantId, livemode], references: [id, sessionId, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  refunds                  Refund[]
  revenueEntries           RevenueEntry[]
  recoveredGasSponsorships GasSponsorship[]
  hookShortfalls           GasSponsorship[]  @relation("HookShortfall")
  hookCalls                HookCall[]
  settlementClaims         SettlementClaim[]

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([sessionId])
  @@map("payments")
}

/// The destination transfer event that settled (or, for a late deposit, was returned for) a
/// payment. One event settles at most one payment (unique per tx, receipt and event); one
/// transaction may carry several (batched settlements).
model SettlementClaim {
  id         String   @id
  merchantId String   @map("merchant_id")
  livemode   Boolean
  paymentId  String   @unique @map("payment_id")
  txHash     String   @map("tx_hash")
  receiptId  String   @map("receipt_id")
  /// `<log index>.<data entry>.<token index>`, or `oneclick` for an unverified-chain payout.
  eventKey   String   @map("event_key")
  amount     Decimal  @db.Decimal(78, 0)
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([livemode, txHash, receiptId, eventKey], map: "settlement_claims_event_key")
  @@index([merchantId])
  @@map("settlement_claims")
}

model Refund {
  id                    String           @id
  merchantId            String           @map("merchant_id")
  livemode              Boolean
  paymentId             String           @map("payment_id")
  reason                RefundReason
  refundTxHash          String?          @map("refund_tx_hash")
  status                ExternalTxStatus @default(pending)
  /// The project 2 `refund` proposal that returns the money (null when 1Click refunds directly).
  proposalId            String?          @map("proposal_id")
  /// Where the money goes; null while `needs_address`.
  destination           String?          @map("destination")
  destinationChain      String?          @map("destination_chain")
  assetId               String           @map("asset_id")
  amount                Decimal          @db.Decimal(78, 0)
  /// The sender is a known exchange: no return address until the shopper gives one.
  needsAddress          Boolean          @default(false) @map("needs_address")
  /// A signer typed the legal-clearance acknowledgement (required to refund a held payment).
  acknowledgedLegalAt   DateTime?        @map("acknowledged_legal_at")
  /// Estimated cross-chain return fee deducted from the gross return (`amount` is net).
  returnFee             Decimal?         @map("return_fee") @db.Decimal(78, 0)
  /// Set when the return needs a person before a draft: `sanctions`, `needs_swap_route`,
  /// `price_unavailable` or `no_sender`.
  reviewReason          String?          @map("review_reason")
  /// sha256 (hex) of the single-use return-address token emailed to the shopper (Ruling C20).
  addressTokenHash      String?          @map("address_token_hash")
  addressTokenExpiresAt DateTime?        @map("address_token_expires_at")
  /// `merchant` refunds only: the store's own id for the refund (the WooCommerce refund id).
  externalRef           String?          @map("external_ref")
  /// `merchant` refunds only: the USD amount the store asked to return. `amount` is that plus
  /// `return_fee` (the merchant pays the network cost), in `asset_id` base units.
  requestedAmountUsd    Decimal?         @map("requested_amount_usd") @db.Decimal(18, 2)
  /// `merchant` refunds only: the store's free-text reason.
  note                  String?          @map("note")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  merchant Merchant         @relation(fields: [merchantId], references: [id])
  payment  Payment          @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  proposal AccountProposal? @relation(fields: [proposalId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  // One automatic return per payment and reason (the watcher hook and the sweeper are idempotent
  // on it): a partial unique index on (payment_id, reason) WHERE reason <> 'merchant', in
  // migration merchant_refunds_indexes. `merchant` refunds are several per payment, one per
  // `external_ref` (automatic rows have none, so the plain unique below never binds them).
  @@unique([paymentId, externalRef])
  @@index([merchantId])
  @@index([paymentId])
  @@index([proposalId])
  @@map("refunds")
}

// ─── Delivery, gas & audit ──────────────────────────────────────────────────

model WebhookDelivery {
  id             String    @id
  merchantId     String    @map("merchant_id")
  livemode       Boolean
  endpointId     String    @map("endpoint_id")
  sessionId      String?   @map("session_id")
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  idempotencyKey String    @unique @map("idempotency_key")
  attempt        Int       @default(0)
  statusCode     Int?      @map("status_code")
  nextRetryAt    DateTime? @map("next_retry_at")
  /// pending (retrying) | delivered | failed (gave up after the retry window; resend still allowed)
  /// | superseded (a site re-connect found the new endpoint already had this event; never sent)
  status         String    @default("pending")
  firstAttemptAt DateTime? @map("first_attempt_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  deliveredAt    DateTime? @map("delivered_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  endpoint WebhookEndpoint @relation(fields: [endpointId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  session  Session?        @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  event    Event           @relation(fields: [eventId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([endpointId])
  @@index([eventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model HookCall {
  id             String           @id
  merchantId     String           @map("merchant_id")
  livemode       Boolean
  sessionId      String           @map("session_id")
  /// The settled payment this call notifies the integrator's contract of.
  paymentId      String           @map("payment_id")
  chain          String
  targetContract String           @map("target_contract")
  /// The session's `hook_data`, as sent in the call.
  hookData       Json             @map("hook_data")
  txHash         String?          @map("tx_hash")
  attempt        Int              @default(0)
  status         ExternalTxStatus @default(pending)
  /// When the next attempt is due (retry backoff); null once the call is done.
  nextRetryAt    DateTime?        @map("next_retry_at")
  /// A worker's claim on the call (at most one attempt in flight).
  leaseUntil     DateTime?        @map("lease_until")
  /// The last failure (e.g. the revert reason).
  lastError      String?          @map("last_error")
  /// Automatic retries stop here (3 days after the call was created). A manual resend sets it to
  /// the resend time: that attempt is one-off.
  retryUntil     DateTime         @map("retry_until")
  /// When `hook.failed` was recorded (and the merchant alerted): once per call, never again.
  alertedAt      DateTime?        @map("alerted_at")
  /// The actual gas cost of every attempt so far (USD), when priced.
  costUsd        Decimal?         @map("cost_usd") @db.Decimal(18, 6)
  /// When the call succeeded.
  succeededAt    DateTime?        @map("succeeded_at")
  /// Manual resends so far (at most HOOK_MAX_MANUAL_RESENDS: each is an attempt Tendr pays for).
  manualResends  Int              @default(0) @map("manual_resends")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  session  Session  @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  payment  Payment  @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  /// One hook call per payment.
  @@unique([paymentId])
  @@index([merchantId])
  @@index([sessionId])
  @@index([status, nextRetryAt])
  @@map("hook_calls")
}

model GasSponsorship {
  id                     String               @id
  merchantId             String               @map("merchant_id")
  livemode               Boolean
  sessionId              String               @map("session_id")
  chain                  String
  txHash                 String?              @map("tx_hash")
  method                 SponsorshipMethod
  provider               String
  userOpHash             String?              @map("user_op_hash")
  sponsor                Sponsor
  gasUsed                Decimal?             @map("gas_used") @db.Decimal(78, 0)
  costUsd                Decimal?             @map("cost_usd") @db.Decimal(18, 6)
  recoveredFromPaymentId String?              @map("recovered_from_payment_id")
  /// `method = hook` rows: the payment whose integrator hook gas this shortfall is (never
  /// `recovered_from_payment_id`: nothing was recovered from that payment for it).
  hookPaymentId          String?              @map("hook_payment_id")
  status                 ExternalTxStatus     @default(pending)
  /// Shopper-paid fee: how it was paid; null when the merchant sponsors.
  feeMode                FeeMode?             @map("fee_mode")
  /// Shopper-paid token fee: the asset (1Click id) and amount (base units) signed.
  feeAsset               String?              @map("fee_asset")
  feeAmount              Decimal?             @map("fee_amount") @db.Decimal(78, 0)
  /// The quoted network cost (USD): what the merchant is charged when it sponsors (spec §8.1).
  estimateUsd            Decimal?             @map("estimate_usd") @db.Decimal(18, 6)
  /// The hold on the monthly gas budget; null when nothing was reserved (shopper-paid).
  reservationState       GasReservationState? @map("reservation_state")
  /// When Tendr recognised the cost as its own loss (`sponsor = tendr`, `recognizeTendrLoss`);
  /// the daily loss cap counts by this time.
  lossRecognizedAt       DateTime?            @map("loss_recognized_at")
  /// The quote a relayed submission paid (set when the relayer accepts the shopper's signatures).
  quoteId                String?              @map("quote_id")
  /// The address that signed the relayed payment (the quote's `wallet_address`).
  signerAddress          String?              @map("signer_address")
  /// The relayer's on-chain transaction (EVM: `relayer_transactions`).
  relayerTxId            String?              @map("relayer_tx_id")
  /// Why a relayed submission failed.
  lastError              String?              @map("last_error")
  /// Shopper-paid fee leg: the fee the relayed transaction actually moved to the gas-fee address
  /// (its `TendrPaid` event; 0 when the authorization was cancelled or skipped). Revenue is booked
  /// from this, never from the quote.
  feeCollected           Decimal?             @map("fee_collected") @db.Decimal(78, 0)
  /// Pimlico paymaster submission: `{ entryPoint, chainId, result }`, the ERC-7677
  /// `pm_getPaymasterData` result handed to the wallet (returned again for the same user operation).
  paymasterData          Json?                @map("paymaster_data")
  /// The part of the actual cost Tendr did not recover (cost − collected fee, or cost − the
  /// merchant's estimate), recognised when the receipt arrives; counted by the daily loss cap
  /// while the row is not itself a Tendr loss (`sponsor = tendr`).
  unrecoveredUsd         Decimal?             @map("unrecovered_usd") @db.Decimal(18, 6)
  unrecoveredAt          DateTime?            @map("unrecovered_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  session              Session             @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  recoveredFromPayment Payment?            @relation(fields: [recoveredFromPaymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  hookPayment          Payment?            @relation("HookShortfall", fields: [hookPaymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  /// Quotes holding this sponsorship as their budget reservation.
  quotes               Quote[]             @relation("QuoteReservation")
  quote                Quote?              @relation("RelayedQuote", fields: [quoteId, sessionId, merchantId, livemode], references: [id, sessionId, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  relayerTx            RelayerTransaction? @relation(fields: [relayerTxId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Lets quotes pin their reservation to the same merchant and mode (quotes FK).
  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([sessionId])
  @@index([livemode, lossRecognizedAt])
  @@index([livemode, unrecoveredAt])
  @@index([quoteId])
  @@index([hookPaymentId])
  @@map("gas_sponsorships")
}

/// A transaction the relayer signs and pays gas for (project 5a §3.1). Owned by the EVM sender:
/// it records the nonce and every broadcast (replacements included) before it is sent, so an
/// unknown outcome is reconciled from the chain, never by signing a new nonce blindly.
model RelayerTransaction {
  id                   String           @id
  /// 1Click blockchain id (`base`, `arb`, …) and the EIP-155 chain id.
  chain                String
  chainId              Int              @map("chain_id")
  fromAddress          String           @map("from_address")
  nonce                BigInt
  toAddress            String           @map("to_address")
  data                 String
  gasLimit             Decimal          @map("gas_limit") @db.Decimal(78, 0)
  maxFeePerGas         Decimal          @map("max_fee_per_gas") @db.Decimal(78, 0)
  maxPriorityFeePerGas Decimal          @map("max_priority_fee_per_gas") @db.Decimal(78, 0)
  /// The latest signed transaction (0x RLP) and its hash; `tx_hashes` holds every hash broadcast
  /// at this nonce (replacements and the deadline cancel), oldest first.
  rawTx                String           @map("raw_tx")
  txHash               String           @map("tx_hash")
  txHashes             String[]         @map("tx_hashes")
  /// The 0-value self-transfer that freed the nonce after `give_up_at` (null until sent).
  cancelTxHash         String?          @map("cancel_tx_hash")
  status               ExternalTxStatus @default(pending)
  /// What the transaction is for (`gasless_payment`) and the record it belongs to.
  purpose              String
  refId                String           @map("ref_id")
  broadcastAt          DateTime?        @map("broadcast_at")
  /// After this the transaction is no longer worth mining: the nonce is freed with a cancel.
  giveUpAt             DateTime         @map("give_up_at")
  attempts             Int              @default(0)
  minedHash            String?          @map("mined_hash")
  gasUsed              Decimal?         @map("gas_used") @db.Decimal(78, 0)
  effectiveGasPrice    Decimal?         @map("effective_gas_price") @db.Decimal(78, 0)
  /// OP-stack chains: the receipt's L1 data fee (wei), charged on top of gas.
  l1Fee                Decimal?         @map("l1_fee") @db.Decimal(78, 0)
  lastError            String?          @map("last_error")
  /// Logs of the mined receipt emitted by `to_address` (the purpose decodes them).
  receiptLogs          Json?            @map("receipt_logs")
  leaseUntil           DateTime?        @map("lease_until")
  /// The outcome was handed to the purpose's handler (gasless: sponsorship updated).
  outcomeHandledAt     DateTime?        @map("outcome_handled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  gasSponsorships GasSponsorship[]

  @@index([chain, fromAddress, nonce])
  @@index([status, leaseUntil])
  @@index([purpose, refId])
  @@map("relayer_transactions")
}

/// A gasless Tron payment's first step (project 5a, spec §2.3 Tron; rulings T9-b … T9-e): the
/// shopper's signed exact-amount `approve(forwarder, amount + fee)` for one quote, which Tendr
/// verifies, funds with just-in-time `gas-tron` delegations (`tron_delegations`) and broadcasts.
/// The relayer's own record (infra): ids of the merchant, session and quote are kept for lookups.
model TronApproval {
  id                 String           @id
  merchantId         String           @map("merchant_id")
  livemode           Boolean
  sessionId          String           @map("session_id")
  quoteId            String           @map("quote_id")
  /// The shopper (base58): the approve's owner and the delegations' receiver.
  wallet             String
  /// sha256 of the signed raw data (hex); stored before anything is broadcast.
  txId               String           @map("tx_id")
  /// The signed `Transaction` (protobuf, hex): re-broadcast as is until it lands or cannot.
  signedTx           String           @map("signed_tx")
  expiration         DateTime
  /// pending: delegations in flight, approve not sent yet; submitted: approve sent.
  status             ExternalTxStatus @default(pending)
  broadcastAt        DateTime?        @map("broadcast_at")
  /// First look that found the approve unknown with the solidified head past its expiration.
  expiredSeenAt      DateTime?        @map("expired_seen_at")
  /// Energy the approve took from the shopper's own and delegated energy (its receipt).
  energyUsed         BigInt?          @map("energy_used")
  /// Value (sun) of the `gas-tron` resources this approval used: its delegations' transactions
  /// and the delegated energy the approve consumed (see relayer/tron-energy.ts, cost model).
  costSun            BigInt?          @map("cost_sun")
  /// Where `cost_sun` is counted: the payment submission (`gas_sponsorships.id`) whose cost
  /// includes it, or a `sponsor = tendr` row of its own. Null until counted.
  costBookedTo       String?          @map("cost_booked_to")
  /// The part of `cost_sun` the payment submission carries (set when it is booked to one); any
  /// cost measured later (energy the shopper spent elsewhere) is Tendr's at close.
  costBookedSun      BigInt?          @map("cost_booked_sun")
  /// The `sponsor = tendr` row holding this approval's provisional cost: the most its
  /// delegations can cost, recognised when they are made (the daily loss cap sees it at once),
  /// set to the actual unrecovered cost at close.
  provisionalCostId  String?          @map("provisional_cost_id")
  /// How many delegations the claim planned (0: the shopper had the resources); an approval
  /// whose rows never appeared is failed, never sent without its energy.
  plannedDelegations Int              @default(0) @map("planned_delegations")
  /// The `TendrPayment` issued for this approval (step 2): its deadline. The nonce is the quote's.
  paymentDeadline    DateTime?        @map("payment_deadline")
  lastError          String?          @map("last_error")
  /// Final: the approve's outcome is known, every delegation is reclaimed, the cost is counted.
  closedAt           DateTime?        @map("closed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  delegations TronDelegation[]

  @@index([wallet, createdAt])
  @@index([quoteId])
  @@index([sessionId])
  @@index([livemode, status, updatedAt])
  @@map("tron_approvals")
}

/// One just-in-time delegation of `gas-tron`'s energy or bandwidth to a shopper, for one approve
/// (ruling T9-d): recorded before it is broadcast, reclaimed with `undelegateResource` once the
/// approve's outcome is known or ten minutes after it was delegated. The reclaim job resumes from
/// these rows (idempotent across restarts).
model TronDelegation {
  id                   String    @id
  approvalId           String    @map("approval_id")
  livemode             Boolean
  /// `energy` | `bandwidth`.
  resource             String
  receiver             String
  /// TRX (sun) whose resource is lent, and the resource units it gave when delegated.
  balanceSun           BigInt    @map("balance_sun")
  units                BigInt
  /// `delegating` → `delegated` → `reclaiming` → `reclaimed`; `failed` when it never took effect.
  status               String
  delegateTxId         String    @map("delegate_tx_id")
  delegateTx           String    @map("delegate_tx")
  delegateExpiration   DateTime  @map("delegate_expiration")
  delegatedAt          DateTime? @map("delegated_at")
  /// Energy delegations: the receiver's `EnergyUsed` when delegated and just before the reclaim;
  /// the difference (capped at `units`) is the lent energy actually consumed, by anything.
  energyUsedBefore     BigInt?   @map("energy_used_before")
  energyUsedAfter      BigInt?   @map("energy_used_after")
  /// sun the delegate / undelegate transactions burned (their receipts).
  delegateFeeSun       BigInt?   @map("delegate_fee_sun")
  undelegateTxId       String?   @map("undelegate_tx_id")
  undelegateTx         String?   @map("undelegate_tx")
  undelegateExpiration DateTime? @map("undelegate_expiration")
  undelegateFeeSun     BigInt?   @map("undelegate_fee_sun")
  /// First look that found the current transaction unknown past its expiration (solidified).
  expiredSeenAt        DateTime? @map("expired_seen_at")
  reclaimedAt          DateTime? @map("reclaimed_at")
  lastError            String?   @map("last_error")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  approval TronApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([approvalId])
  @@index([livemode, status, updatedAt])
  @@index([receiver, status])
  @@map("tron_delegations")
}

model ScreeningResult {
  id         String            @id
  merchantId String            @map("merchant_id")
  livemode   Boolean
  sessionId  String            @map("session_id")
  address    String
  chain      String
  provider   String
  riskScore  Decimal           @map("risk_score") @db.Decimal(5, 2)
  decision   ScreeningDecision
  createdAt  DateTime          @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  session  Session  @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([sessionId])
  @@map("screening_results")
}

/// Append-only (trigger `events_no_update`). merchant_id / livemode are null for system events.
model Event {
  id            String   @id
  merchantId    String?  @map("merchant_id")
  livemode      Boolean?
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  type          String
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  merchant   Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]
  outbox     EventOutbox?

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@map("events")
}

// ─── Revenue & branding ─────────────────────────────────────────────────────

model FeePlan {
  id              String   @id
  merchantId      String   @map("merchant_id")
  feeBps          Int      @map("fee_bps")
  defaultFeePayer FeePayer @map("default_fee_payer")
  volumeTiers     Json     @map("volume_tiers")
  effectiveFrom   DateTime @map("effective_from")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("fee_plans")
}

model RevenueEntry {
  id         String        @id
  merchantId String        @map("merchant_id")
  livemode   Boolean
  paymentId  String        @map("payment_id")
  source     RevenueSource
  assetId    String        @map("asset_id")
  amount     Decimal       @db.Decimal(78, 0)
  /// USD value at quote prices.
  amountUsd  Decimal?      @map("amount_usd") @db.Decimal(18, 6)
  txHash     String?       @map("tx_hash")
  /// Tells apart several rows of one source on a payment: '' for the settlement lines; the
  /// sponsorship id for a shopper-paid gasless fee leg (`gas_reimbursement`, project 5a).
  reference  String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([paymentId, source, reference])
  @@index([merchantId])
  @@index([paymentId])
  @@map("revenue_entries")
}

model CheckoutTheme {
  id           String      @id
  merchantId   String      @map("merchant_id")
  name         String
  isDefault    Boolean     @default(false) @map("is_default")
  version      Int         @default(1)
  status       ThemeStatus @default(draft)
  /// The editable theme document (`ThemeDocument` in @tendr/contracts).
  draft        Json
  /// The live theme document; null until first published.
  published    Json?
  publishedAt  DateTime?   @map("published_at")
  /// Scoped CSS compiled from `published`.
  publishedCss String?     @map("published_css")
  /// Scoped CSS compiled from `draft`.
  draftCss     String?     @map("draft_css")
  /// Hash of `publishedCss`.
  cssHash      String?     @map("css_hash")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  assets       ThemeAsset[]
  paymentLinks PaymentLink[]
  sessions     Session[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@map("checkout_themes")
}

model ThemeAsset {
  id         String         @id
  merchantId String         @map("merchant_id")
  /// Assets belong to the merchant; any theme may use them.
  themeId    String?        @map("theme_id")
  kind       ThemeAssetKind
  /// Object-store key.
  key        String         @unique
  /// Public URL.
  url        String
  mime       String
  sizeBytes  Int            @map("size_bytes")
  checksum   String
  createdAt  DateTime       @default(now()) @map("created_at")

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  theme    CheckoutTheme? @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([themeId])
  @@map("theme_assets")
}

/// A product image fetched, validated and re-encoded by Tendr (cache keyed by source URL hash).
model ProductImage {
  id         String             @id
  merchantId String             @map("merchant_id")
  /// sha256 hex of `sourceUrl`.
  urlHash    String             @map("url_hash")
  sourceUrl  String             @map("source_url")
  status     ProductImageStatus
  key        String?
  url        String?
  fetchedAt  DateTime?          @map("fetched_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, urlHash])
  @@index([merchantId])
  @@map("product_images")
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

model IdempotencyKey {
  id           String            @id
  merchantId   String            @map("merchant_id")
  livemode     Boolean
  /// `${principal.kind}:${principalRef(principal)}`: keys are namespaced per credential, so one
  /// principal can never have another principal's stored response replayed.
  principalRef String            @map("principal_ref")
  key          String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(in_progress)
  lockedAt     DateTime          @map("locked_at")
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, livemode, principalRef, key])
  @@map("idempotency_keys")
}

/// KMS-envelope-encrypted secret (spec §5). `ciphertext` is the envelope JSON.
// ─── Connect (sites linked to a store, e.g. WooCommerce) ────────────────────

/// A site connected to a store through Connect (prefix `con`). Shared by both modes: it owns one
/// secret key, one publishable key and one webhook endpoint per mode. `site_origin` is the
/// site's origin; `added_domain` is set only when connecting added that origin to the store's
/// `checkout_domains` (so removing the connection may take it away again; a hand-added domain is
/// never removed).
model Connection {
  id                String             @id
  merchantId        String             @map("merchant_id")
  platform          ConnectionPlatform
  siteUrl           String             @map("site_url")
  siteOrigin        String             @map("site_origin")
  connectedByUserId String             @map("connected_by_user_id")
  addedDomain       String?            @map("added_domain")
  /// Set when `/v1/connect/token` handed the credentials out. A connection never redeemed is
  /// revoked by the sweeper after 10 minutes.
  redeemedAt        DateTime?          @map("redeemed_at")
  lastUsedAt        DateTime?          @map("last_used_at")
  revokedAt         DateTime?          @map("revoked_at")
  /// Set only by a site re-connect (ruling W8): the connection that replaced this one. Events of
  /// sessions made with this connection's keys follow the chain to the live successor's endpoints.
  /// Null on a disconnect, a dashboard removal or a sweep: such events reach no bound endpoint.
  replacedById      String?            @map("replaced_by_id")
  /// Brand pulled from the connected site (name, logo, colours); refreshed on demand.
  brand             Json?
  brandUpdatedAt    DateTime?          @map("brand_updated_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  replacedBy       Connection?       @relation("ConnectionReplacement", fields: [replacedById, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  replaces         Connection[]      @relation("ConnectionReplacement")
  connectedBy      User              @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  sessions         Session[]
  authCodes        ConnectAuthCode[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@index([connectedByUserId])
  @@map("connections")
}

/// A single-use Connect authorization code (prefix `cac`): valid 60 s, bound to its connection,
/// the plugin's `return_url` and the PKCE S256 `code_challenge`. Only the sha256 of the raw code
/// is stored. Infrastructure: never reachable through a scoped client.
model ConnectAuthCode {
  id             String    @id
  codeHash       String    @unique @map("code_hash")
  connectionId   String    @map("connection_id")
  returnUrl      String    @map("return_url")
  codeChallenge  String    @map("code_challenge")
  /// The connection's issued raw credentials (JSON), KeyVault-encrypted, until `/token` hands
  /// them out once; the secret row is deleted on redemption or once the code expires.
  credentialsRef String?   @map("credentials_ref")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  connection  Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credentials Secret?    @relation(fields: [credentialsRef], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([connectionId])
  @@map("connect_auth_codes")
}

model Secret {
  id         String   @id
  purpose    String
  ciphertext String
  kek        String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  connectAuthCodes  ConnectAuthCode[]
  notificationLinks Merchant[]        @relation("NotificationEmailLinkSecret")

  @@map("secrets")
}

/// A signer notice email sent for an event, one per (event, recipient): claimed before the send so
/// a replayed handler never mails the same person twice (payment.held, refund.needs_review, …).
model EventNotice {
  id        String   @id
  eventId   String   @map("event_id")
  recipient String
  template  String
  createdAt DateTime @default(now()) @map("created_at")

  /// One mail per (event, template, recipient): two notices of one event never block each other.
  @@unique([eventId, template, recipient])
  @@map("event_notices")
}

model EventOutbox {
  id        String   @id
  eventId   String   @unique @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // The dispatcher reads the oldest rows first (ORDER BY created_at LIMIT 100).
  @@index([createdAt])
  @@map("event_outbox")
}

// ─── Gas-fee sweep and operator alerts (project 5a, Task 12) ─────────────────

enum FeeSweepStatus {
  planned
  /// Sent, its outcome not known yet: blocks re-planning of the account and token until the
  /// transfer is found confirmed (`executed`) or failed, by its hash.
  broadcast
  executed
  failed
  needs_gas

  @@map("fee_sweep_status")
}

/// One sweep of a gas-fee account's token into USDC on NEAR (Tendr's fee account) through a 1Click
/// swap (prefix `fsw`). Live mode only. A `planned` or `needs_gas` row is the open plan for its
/// account and token (at most one: a partial unique index); executing it ends in `broadcast` (sent,
/// awaiting confirmation; no new plan for the account and token meanwhile), then `executed` once
/// confirmed on chain, or `failed`. The 7-day rule reads the last `executed` row per account and
/// token. No key material
/// is ever stored here: the `gas-fees-*` keys stay in the key vault.
model FeeSweep {
  id               String         @id
  livemode         Boolean
  /// `evm` | `solana` | `near` | `tron`.
  family           String
  /// 1Click blockchain id.
  chain            String
  /// The gas-fee account the tokens leave (the `gas-fees-*` key's address).
  accountAddress   String         @map("account_address")
  /// The 1Click asset swept, its symbol, the amount (base units) and its USD value when planned.
  assetId          String         @map("asset_id")
  symbol           String
  amount           Decimal        @db.Decimal(78, 0)
  amountUsd        Decimal        @map("amount_usd") @db.Decimal(18, 6)
  /// Why it is due: `threshold` (value ≥ FEE_SWEEP_THRESHOLD_USD) or `weekly`.
  reason           String
  status           FeeSweepStatus @default(planned)
  /// The 1Click quote (its correlation id) and the deposit address the transfer goes to.
  quoteId          String?        @map("quote_id")
  depositAddress   String?        @map("deposit_address")
  /// The destination: USDC on NEAR into TENDR_FEE_ACCOUNT_NEAR.
  destinationAsset String?        @map("destination_asset")
  recipient        String?
  txHash           String?        @map("tx_hash")
  lastError        String?        @map("last_error")
  /// Claimed by one executor until then.
  leaseUntil       DateTime?      @map("lease_until")
  executedAt       DateTime?      @map("executed_at")
  /// When the transfer was broadcast (its outcome is reconciled by `tx_hash` from then on).
  broadcastAt      DateTime?      @map("broadcast_at")
  /// When the attempt failed: the account and token are not planned again for 6 hours.
  failedAt         DateTime?      @map("failed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([livemode, chain, accountAddress, assetId, status])
  @@map("fee_sweeps")
}

/// Operator alerts throttled per key (e.g. `gas_low:evm:base:0x…`): when each was last sent.
model GasOpsAlert {
  key            String   @id
  lastNotifiedAt DateTime @map("last_notified_at")

  @@map("gas_ops_alerts")
}
