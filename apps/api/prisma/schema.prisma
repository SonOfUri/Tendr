// Tendr foundation schema — see docs/superpowers/specs/2026-10-23-foundation-design.md §1.
//
// Rules:
// - ids are Stripe-style `<prefix>_<ULID>` strings supplied by application code (no @default).
// - every FK between merchant-owned tables is composite: (parent_id, merchant_id[, livemode]),
//   so the database rejects cross-merchant and cross-mode links. Parents therefore carry
//   @@unique([id, merchantId]) / @@unique([id, merchantId, livemode]).
// - `events` is append-only (trigger in the foundation migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum MerchantKind {
  merchant
  integrator

  @@map("merchant_kind")
}

enum MerchantStatus {
  active
  suspended
  closed

  @@map("merchant_status")
}

enum MerchantUserRole {
  owner
  admin
  finance
  viewer

  @@map("merchant_user_role")
}

enum ApiKeyKind {
  secret
  publishable

  @@map("api_key_kind")
}

enum AccountKeyKind {
  passkey
  fn_call
  recovery

  @@map("account_key_kind")
}

enum PayoutMode {
  wallet
  intents

  @@map("payout_mode")
}

enum AllowlistStatus {
  pending
  active
  revoked

  @@map("allowlist_status")
}

enum PaymentLinkStatus {
  active
  inactive
  expired

  @@map("payment_link_status")
}

enum GasSponsor {
  default
  merchant
  buyer

  @@map("gas_sponsor")
}

enum ResolvedGasSponsor {
  merchant
  buyer

  @@map("resolved_gas_sponsor")
}

enum AmountMode {
  EXACT_IN
  EXACT_OUT

  @@map("amount_mode")
}

enum Delivery {
  WEBHOOK
  HOOK

  @@map("delivery")
}

enum FeePayer {
  merchant
  payer

  @@map("fee_payer")
}

enum SessionStatus {
  PENDING_DEPOSIT
  PROCESSING
  SETTLED
  REFUNDED
  EXPIRED
  LATE_DEPOSIT
  HELD
  SCREENING_PENDING

  @@map("session_status")
}

/// Why a session is EXPIRED: its lifetime ran out, or the store canceled it.
enum SessionExpiredReason {
  timeout
  canceled

  @@map("session_expired_reason")
}

enum PaymentStatus {
  DETECTED
  PROCESSING
  SETTLED
  REFUNDING
  REFUNDED
  HELD
  SCREENING_PENDING

  @@map("payment_status")
}

/// Where 1Click delivers a session's swap output (`recipientType` of the 1Click request).
enum RecipientType {
  INTENTS
  DESTINATION_CHAIN

  @@map("recipient_type")
}

/// Where 1Click sends refunds for a quote (`refundType` of the 1Click request).
enum QuoteRefundType {
  ORIGIN_CHAIN
  INTENTS

  @@map("quote_refund_type")
}

/// Why a payment is HELD.
enum HeldReason {
  sanctions
  screening_unavailable

  @@map("held_reason")
}

enum RefundReason {
  expired
  late
  underpaid
  failed
  overpaid
  sanctions

  @@map("refund_reason")
}

enum ExternalTxStatus {
  pending
  submitted
  confirmed
  failed

  @@map("external_tx_status")
}

enum SponsorshipMethod {
  eip3009
  permit
  paymaster
  paymaster_verifying
  paymaster_erc20
  energy
  fee_payer

  @@map("sponsorship_method")
}

enum Sponsor {
  merchant
  tendr

  @@map("sponsor")
}

enum ScreeningDecision {
  allow
  block

  @@map("screening_decision")
}

enum RevenueSource {
  app_fee
  spread
  oneclick_fee
  network_fee
  gas_reimbursement

  @@map("revenue_source")
}

enum ThemeStatus {
  draft
  published

  @@map("theme_status")
}

enum ThemeMode {
  light
  dark
  auto

  @@map("theme_mode")
}

enum ThemeLayout {
  modal
  inline
  page

  @@map("theme_layout")
}

enum ThemeAssetKind {
  logo
  image
  font

  @@map("theme_asset_kind")
}

enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

enum WebauthnChallengePurpose {
  registration
  authentication
  /// A recovery-kit sign-in (lost all passkeys): the store's recovery key signs it.
  recovery_session

  @@map("webauthn_challenge_purpose")
}

enum EmailTokenPurpose {
  verify
  login
  invite
  /// The mailbox half of a recovery-kit passkey registration (R28): sent when a restricted
  /// recovery session opens; registering needs it AND the kit session.
  recovery_register

  @@map("email_token_purpose")
}

enum MerchantAccountStatus {
  provisioning
  active
  failed

  @@map("merchant_account_status")
}

/// The contract's `Action` variants in snake_case, in Borsh order (see @tendr/contracts).
enum ProposalKind {
  add_signer
  remove_signer
  add_signer_key
  remove_signer_key
  set_threshold
  set_origins
  rotate_recovery_key
  add_saved_address
  remove_saved_address
  set_limits
  set_refund_cap
  set_auto_sweep
  clear_auto_sweep
  withdraw
  refund
  upgrade
  set_settlement

  @@map("proposal_kind")
}

enum ProposalStatus {
  draft
  pending
  timelocked
  executing
  executed
  cancelled
  expired
  failed

  @@map("proposal_status")
}

enum RecoveryStatus {
  pending
  cancelled
  executed
  failed

  @@map("recovery_status")
}

// ─── People (global; not owned by a merchant) ───────────────────────────────

/// A person. `id` (`per_…`) is also their signer id on merchant account contracts.
/// `email` is stored lower-cased (CHECK users_email_lowercase).
model User {
  id              String    @id
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships       MerchantUser[]
  credentials       WebauthnCredential[]
  dashboardSessions DashboardSession[]
  challenges        WebauthnChallenge[]
  accountKeys       AccountKey[]
  proposals         AccountProposal[]
  approvals         AccountApproval[]

  @@map("users")
}

/// A passkey. An active `public_key` is unique (a partial unique index in migration
/// 20261025170000_dashboard_auth_hardening; Prisma cannot express it).
/// `public_key` is the contract's `SignerKey` JSON:
/// `{ "p256": "<base64 33-byte compressed SEC1>" }` or `{ "ed25519": "<base64 32 bytes>" }`.
model WebauthnCredential {
  id           String    @id
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Json      @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]
  deviceLabel  String?   @map("device_label")
  lastUsedAt   DateTime? @map("last_used_at")
  /// Set when the person removes the passkey. A revoked credential never logs in, is never offered
  /// in `allowCredentials` and never approves. Rows are kept: approvals reference them.
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals   AccountApproval[]
  accountKeys AccountKey[]

  // Lets approvals and account keys pin a credential to its owner (composite FKs).
  @@unique([id, userId])
  @@index([userId])
  @@map("webauthn_credentials")
}

/// A dashboard login. Sliding expiry: each use moves `expires_at` (default 30 days).
model DashboardSession {
  id                 String    @id
  userId             String    @map("user_id")
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  lastUsedAt         DateTime? @map("last_used_at")
  /// When this session last proved a passkey (login, first registration, step-up). Sensitive
  /// actions need it within the last 10 minutes.
  passkeyVerifiedAt  DateTime? @map("passkey_verified_at")
  /// Set on a RESTRICTED session opened with the store's recovery kit (lost all passkeys): it may
  /// only register a passkey for its person and start a recovery of this store; every other route
  /// refuses it. Plain column (no FK): sessions are identity rows, outside tenant scoping.
  recoveryMerchantId String?   @map("recovery_merchant_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("dashboard_sessions")
}

/// One-time email links (verify, login, invite). `email` is lower-cased.
model EmailToken {
  id         String            @id
  email      String
  purpose    EmailTokenPurpose
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at")
  consumedAt DateTime?         @map("consumed_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_tokens")
}

/// Server-issued WebAuthn ceremony challenges (passkey registration and login): random, single-use,
/// valid 5 minutes. Only `sha256(challenge)` is stored. Proposal approvals never use these: their
/// challenge is the 32-byte payload hash, while these carry a fixed tag and are longer.
model WebauthnChallenge {
  id            String                   @id
  purpose       WebauthnChallengePurpose
  challengeHash String                   @unique @map("challenge_hash")
  /// The person registering (registration only); login challenges are not bound to a person.
  userId        String?                  @map("user_id")
  expiresAt     DateTime                 @map("expires_at")
  consumedAt    DateTime?                @map("consumed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ─── Merchant domain ────────────────────────────────────────────────────────

model Merchant {
  id              String             @id
  name            String
  slug            String             @unique
  kind            MerchantKind       @default(merchant)
  aupAcceptedAt   DateTime?          @map("aup_accepted_at")
  status          MerchantStatus     @default(active)
  /// Origins allowed to frame the checkout (CSP `frame-ancestors`); shared by both modes.
  checkoutDomains String[]           @default([]) @map("checkout_domains")
  defaultFeePayer FeePayer           @default(merchant) @map("default_fee_payer")
  defaultGasPayer ResolvedGasSponsor @default(buyer) @map("default_gas_payer")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  users             MerchantUser[]
  apiKeys           ApiKey[]
  accountKeys       AccountKey[]
  settlementConfigs SettlementConfig[]
  payoutAllowlist   PayoutAllowlistEntry[]
  webhookEndpoints  WebhookEndpoint[]
  gasPolicies       GasPolicy[]
  paymentLinks      PaymentLink[]
  sessions          Session[]
  quotes            Quote[]
  payments          Payment[]
  refunds           Refund[]
  webhookDeliveries WebhookDelivery[]
  hookCalls         HookCall[]
  gasSponsorships   GasSponsorship[]
  screeningResults  ScreeningResult[]
  events            Event[]
  feePlans          FeePlan[]
  revenueEntries    RevenueEntry[]
  settlementClaims  SettlementClaim[]
  checkoutThemes    CheckoutTheme[]
  themeAssets       ThemeAsset[]
  idempotencyKeys   IdempotencyKey[]
  invites           MerchantInvite[]
  merchantAccounts  MerchantAccount[]
  accountProposals  AccountProposal[]
  accountApprovals  AccountApproval[]
  recoveryRequests  RecoveryRequest[]
  accountLimits     AccountLimit[]

  @@map("merchants")
}

/// A person's membership of a merchant (prefix `usr`). `is_signer` mirrors whether the person
/// is a signer on the merchant's account contracts.
model MerchantUser {
  id         String           @id
  merchantId String           @map("merchant_id")
  userId     String           @map("user_id")
  role       MerchantUserRole
  isSigner   Boolean          @default(false) @map("is_signer")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([merchantId, userId])
  @@index([userId])
  @@map("merchant_users")
}

/// An invitation to join a merchant. `email` is lower-cased; the raw token is never stored.
model MerchantInvite {
  id         String           @id
  merchantId String           @map("merchant_id")
  email      String
  role       MerchantUserRole
  makeSigner Boolean          @default(false) @map("make_signer")
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_invites")
}

model ApiKey {
  id               String     @id
  merchantId       String     @map("merchant_id")
  livemode         Boolean
  name             String
  kind             ApiKeyKind
  keyPrefix        String     @map("key_prefix")
  keyHash          String     @unique @map("key_hash")
  scopes           String[]
  signingSecretRef String?    @map("signing_secret_ref")
  signingRequired  Boolean    @default(false) @map("signing_required")
  lastUsedAt       DateTime?  @map("last_used_at")
  revokedAt        DateTime?  @map("revoked_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  merchant      Merchant @relation(fields: [merchantId], references: [id])
  signingSecret Secret?  @relation(fields: [signingSecretRef], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("api_keys")
}

/// A public key registered on a merchant account contract. `user_id` is null for the recovery
/// key; `credential_id`, when set, must be a passkey of that same person (composite FK).
model AccountKey {
  id            String         @id
  merchantId    String         @map("merchant_id")
  livemode      Boolean
  nearAccountId String         @map("near_account_id")
  publicKey     String         @map("public_key")
  kind          AccountKeyKind
  userId        String?        @map("user_id")
  credentialId  String?        @map("credential_id")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant   Merchant            @relation(fields: [merchantId], references: [id])
  user       User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credential WebauthnCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([userId])
  @@map("account_keys")
}

// ─── Merchant accounts (on-chain threshold contracts) ───────────────────────

/// The merchant's NEAR account for one mode. Postgres mirrors the contract; the contract is
/// authoritative. Replaces the idea of `merchants.near_account_id`.
model MerchantAccount {
  id                 String                @id
  merchantId         String                @map("merchant_id")
  livemode           Boolean
  nearAccountId      String                @unique @map("near_account_id")
  contractCodeHash   String?               @map("contract_code_hash")
  threshold          Int
  signerEpoch        BigInt                @default(0) @map("signer_epoch")
  status             MerchantAccountStatus @default(provisioning)
  createdTx          String?               @map("created_tx")
  /// The provisioning attempt holding the row (see accounts/accounts.ts): set with
  /// `provision_claimed_at` when an attempt claims it, cleared when that attempt ends. A claim
  /// older than the lease (5 minutes) is stale and may be taken over.
  provisionAttemptId String?               @map("provision_attempt_id")
  provisionClaimedAt DateTime?             @map("provision_claimed_at")
  /// Reconciliation cursor: how many on-chain proposals (`list_proposals`, creation order, never
  /// removed) the watcher has read. Open ones are re-read by id.
  proposalsSeen      Int                   @default(0) @map("proposals_seen")
  /// Mirror of the contract's `recovery_key_epoch` (`get_config`); recovery payloads sign it.
  recoveryKeyEpoch   BigInt?               @map("recovery_key_epoch")
  reconciledAt       DateTime?             @map("reconciled_at")
  /// Set while a storage top-up is blocked by the funding daily cap (R35); the dashboard warns
  /// while it is set. Cleared once the account has enough free balance again.
  storageLowAt       DateTime?             @map("storage_low_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  proposals        AccountProposal[]
  recoveryRequests RecoveryRequest[]
  limits           AccountLimit[]

  @@unique([merchantId, livemode])
  @@unique([id, merchantId, livemode])
  @@map("merchant_accounts")
}

/// A proposal on the account contract. `onchain_id` is the 32-byte proposal id as lower-case hex
/// (sha256(borsh(action) ‖ salt)); `salt` is base64; `action` is the contract `Action` JSON.
model AccountProposal {
  id              String         @id
  merchantId      String         @map("merchant_id")
  livemode        Boolean
  accountId       String         @map("account_id")
  onchainId       String         @map("onchain_id")
  kind            ProposalKind
  action          Json
  salt            String
  status          ProposalStatus @default(draft)
  /// Null when the proposal was first seen on chain and its creator is not a known person.
  createdByUserId String?        @map("created_by_user_id")
  readyAt         DateTime?      @map("ready_at")
  executedAt      DateTime?      @map("executed_at")
  lastTxHash      String?        @map("last_tx_hash")
  /// Set while a signer's first approval of a draft is being relayed (`propose`): a claim that
  /// stops a local draft cancel from racing the relay. Cleared when the relay ends; a claim older
  /// than the lease (2 minutes) is stale and may be taken over.
  relayClaimedAt  DateTime?      @map("relay_claimed_at")
  /// An expired proposal holds its creator's pending slot on chain until `execute` marks it
  /// expired there. Set once the executor job settled it (I3).
  expirySettledAt DateTime?      @map("expiry_settled_at")
  /// For a system-drafted `refund` proposal: the refund it returns (exact back-link, set once).
  refundId        String?        @map("refund_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  merchant  Merchant          @relation(fields: [merchantId], references: [id])
  account   MerchantAccount   @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals AccountApproval[]
  refunds   Refund[]

  @@unique([accountId, onchainId])
  @@unique([id, merchantId, livemode])
  @@index([merchantId, livemode, status])
  @@index([refundId])
  @@map("account_proposals")
}

/// One signer's approval of a proposal, with the passkey and signer epoch it was made under.
/// The contract keeps at most one approval per signer (re-approving replaces it), so this does too.
model AccountApproval {
  id           String   @id
  merchantId   String   @map("merchant_id")
  livemode     Boolean
  proposalId   String   @map("proposal_id")
  userId       String   @map("user_id")
  credentialId String   @map("credential_id")
  signerEpoch  BigInt   @map("signer_epoch")
  txHash       String?  @map("tx_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant   Merchant           @relation(fields: [merchantId], references: [id])
  proposal   AccountProposal    @relation(fields: [proposalId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credential WebauthnCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([proposalId, userId])
  @@index([merchantId])
  @@index([userId])
  @@map("account_approvals")
}

/// A recovery started with the recovery key: replaces the signer set after 72 h unless a signer
/// cancels. `onchain_id` is the contract's recovery id (hex) once started.
model RecoveryRequest {
  id               String         @id
  merchantId       String         @map("merchant_id")
  livemode         Boolean
  accountId        String         @map("account_id")
  onchainId        String?        @map("onchain_id")
  executesAt       DateTime       @map("executes_at")
  status           RecoveryStatus @default(pending)
  newSignerIds     String[]       @map("new_signer_ids")
  newThreshold     Int?           @map("new_threshold")
  nonce            BigInt?
  /// The recovery-key epoch the recovery was started under (part of its id).
  recoveryKeyEpoch BigInt?        @map("recovery_key_epoch")
  startTxHash      String?        @map("start_tx_hash")
  cancelTxHash     String?        @map("cancel_tx_hash")
  executeTxHash    String?        @map("execute_tx_hash")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  account  MerchantAccount @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, onchainId])
  @@index([merchantId, livemode, status])
  @@map("recovery_requests")
}

/// Mirror of the contract's per-asset limits, refund cap and auto-sweep rule (`get_limits`,
/// `get_auto_sweep`). Amounts are the asset's smallest units. Display and fast validation only.
model AccountLimit {
  id                  String   @id
  merchantId          String   @map("merchant_id")
  livemode            Boolean
  accountId           String   @map("account_id")
  asset               String
  perTx               Decimal? @map("per_tx") @db.Decimal(78, 0)
  perDay              Decimal? @map("per_day") @db.Decimal(78, 0)
  refundCap           Decimal? @map("refund_cap") @db.Decimal(78, 0)
  sweepTriggerAbove   Decimal? @map("sweep_trigger_above") @db.Decimal(78, 0)
  sweepKeep           Decimal? @map("sweep_keep") @db.Decimal(78, 0)
  sweepSavedAddressId String?  @map("sweep_saved_address_id")
  sweepChain          String?  @map("sweep_chain")
  sweepAddress        String?  @map("sweep_address")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  account  MerchantAccount @relation(fields: [accountId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accountId, asset])
  @@index([merchantId, livemode])
  @@map("account_limits")
}

// ─── Configuration ──────────────────────────────────────────────────────────

model SettlementConfig {
  id            String     @id
  merchantId    String     @map("merchant_id")
  livemode      Boolean
  destAssetId   String     @map("dest_asset_id")
  destChain     String     @map("dest_chain")
  payoutMode    PayoutMode @map("payout_mode")
  payoutAddress String?    @map("payout_address")
  nearAccount   String?    @map("near_account")
  isDefault     Boolean    @default(false) @map("is_default")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("settlement_configs")
}

model PayoutAllowlistEntry {
  id         String          @id
  merchantId String          @map("merchant_id")
  livemode   Boolean
  chain      String
  address    String
  status     AllowlistStatus @default(pending)
  activeFrom DateTime        @map("active_from")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  // (merchant_id, livemode, chain, address) is unique among non-revoked rows only (a partial
  // unique index in migration 20261025220000_chain_watcher): a removed address may be re-added
  // under a new on-chain id.
  @@index([merchantId, livemode])
  @@map("payout_allowlist")
}

model WebhookEndpoint {
  id         String   @id
  merchantId String   @map("merchant_id")
  livemode   Boolean
  url        String
  secretRef  String   @map("secret_ref")
  events     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  secret     Secret            @relation(fields: [secretRef], references: [id])
  deliveries WebhookDelivery[]

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@map("webhook_endpoints")
}

model GasPolicy {
  id               String   @id
  merchantId       String   @map("merchant_id")
  livemode         Boolean
  enabled          Boolean  @default(false)
  perPaymentCapUsd Decimal  @map("per_payment_cap_usd") @db.Decimal(18, 6)
  monthlyBudgetUsd Decimal  @map("monthly_budget_usd") @db.Decimal(18, 6)
  minOrderUsd      Decimal  @map("min_order_usd") @db.Decimal(18, 6)
  chains           String[]
  tokens           String[]
  firstTimeOnly    Boolean  @default(false) @map("first_time_only")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("gas_policies")
}

// ─── Payments core ──────────────────────────────────────────────────────────

model PaymentLink {
  id             String            @id
  merchantId     String            @map("merchant_id")
  livemode       Boolean
  themeId        String?           @map("theme_id")
  slug           String
  title          String
  amount         Decimal?          @db.Decimal(38, 18)
  amountCurrency String            @map("amount_currency")
  openAmount     Boolean           @default(false) @map("open_amount")
  destAsset      String            @map("dest_asset")
  destChain      String            @map("dest_chain")
  gasSponsor     GasSponsor        @default(default) @map("gas_sponsor")
  gasMaxUsd      Decimal?          @map("gas_max_usd") @db.Decimal(18, 6)
  maxUses        Int?              @map("max_uses")
  useCount       Int               @default(0) @map("use_count")
  expiresAt      DateTime?         @map("expires_at")
  status         PaymentLinkStatus @default(active)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  theme    CheckoutTheme? @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  sessions Session[]

  @@unique([id, merchantId, livemode])
  @@unique([merchantId, livemode, slug])
  @@map("payment_links")
}

model Session {
  id               String                @id
  merchantId       String                @map("merchant_id")
  livemode         Boolean
  themeId          String?               @map("theme_id")
  paymentLinkId    String?               @map("payment_link_id")
  externalRef      String?               @map("external_ref")
  amountMode       AmountMode            @map("amount_mode")
  amount           Decimal               @db.Decimal(38, 18)
  amountCurrency   String                @map("amount_currency")
  destAsset        String                @map("dest_asset")
  destChain        String                @map("dest_chain")
  recipient        String
  /// Pinned at creation: `INTENTS` (recipient is the merchant account) or `DESTINATION_CHAIN`
  /// (recipient is the saved payout address, wallet mode).
  recipientType    RecipientType         @default(INTENTS) @map("recipient_type")
  /// The merchant's intents account at creation: the `INTENTS` refund destination for manual
  /// sends without a refund address (equals `recipient` in intents payout mode).
  intentsAccount   String?               @map("intents_account")
  beneficiary      String?
  delivery         Delivery
  hookData         Json?                 @map("hook_data")
  metadata         Json                  @default("{}")
  feeBps           Int                   @map("fee_bps")
  feePayer         FeePayer              @map("fee_payer")
  /// The resolved gas payer (API `gas_payer`; `buyer` is the shopper).
  gasSponsor       ResolvedGasSponsor    @map("gas_sponsor")
  gasMaxUsd        Decimal?              @map("gas_max_usd") @db.Decimal(18, 6)
  status           SessionStatus         @default(PENDING_DEPOSIT)
  expiresAt        DateTime              @map("expires_at")
  clientSecretHash String                @unique @map("client_secret_hash")
  successUrl       String?               @map("success_url")
  cancelUrl        String?               @map("cancel_url")
  /// Lower-cased (CHECK in migration checkout_core); refund contact and receipts only.
  customerEmail    String?               @map("customer_email")
  expiredReason    SessionExpiredReason? @map("expired_reason")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  theme             CheckoutTheme?    @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)
  paymentLink       PaymentLink?      @relation(fields: [paymentLinkId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  quotes            Quote[]
  payments          Payment[]
  webhookDeliveries WebhookDelivery[]
  hookCalls         HookCall[]
  gasSponsorships   GasSponsorship[]
  screeningResults  ScreeningResult[]

  // (merchant_id, livemode, external_ref) is unique only among PENDING_DEPOSIT, PROCESSING,
  // SCREENING_PENDING and SETTLED sessions (a partial unique index in migration checkout_core):
  // an expired, late or held order may get a new session.
  @@unique([id, merchantId, livemode])
  @@index([status, expiresAt])
  @@map("sessions")
}

model Quote {
  id                   String           @id
  merchantId           String           @map("merchant_id")
  livemode             Boolean
  sessionId            String           @map("session_id")
  originAssetId        String           @map("origin_asset_id")
  depositAddress       String           @map("deposit_address")
  amountIn             Decimal          @map("amount_in") @db.Decimal(78, 0)
  amountOut            Decimal          @map("amount_out") @db.Decimal(78, 0)
  refundTo             String           @map("refund_to")
  deadline             DateTime
  oneclickQuoteRef     String?          @map("oneclick_quote_ref")
  /// Set when a newer quote replaced this one for the session.
  supersededAt         DateTime?        @map("superseded_at")
  amountInUsd          Decimal?         @map("amount_in_usd") @db.Decimal(18, 6)
  /// 1Click's USD value of `amount_out` at quote time (the shopper's fee line is in − out).
  amountOutUsd         Decimal?         @map("amount_out_usd") @db.Decimal(18, 6)
  /// How 1Click returns money for this quote: to `refund_to` on the origin chain (direct), or
  /// into the merchant's intents account (`INTENTS`, signer-approved return-to-sender).
  refundType           QuoteRefundType? @map("refund_type")
  /// The shopper reported a deposit transaction for this quote (`POST …/client/deposit`).
  depositTxHash        String?          @map("deposit_tx_hash")
  depositTxSubmittedAt DateTime?        @map("deposit_tx_submitted_at")
  /// The payment watcher: when the next 1Click status poll is due (also a running poll's claim
  /// lease). A partial index (migration payment_watcher) covers rows still being watched.
  watchNextAt          DateTime?        @map("watch_next_at")
  /// Polling stopped for good (terminal payment, 24 h after creation, or a superseded quote past
  /// its deadline + 30 min with no deposit).
  watchStoppedAt       DateTime?        @map("watch_stopped_at")
  /// When the last poll of this address completed (the expiry sweep waits for one after expiry).
  watchPolledAt        DateTime?        @map("watch_polled_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  session  Session   @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  payments Payment[]

  // Lets payments pin their quote to the same session (payments FK below).
  @@unique([id, sessionId, merchantId, livemode])
  @@unique([livemode, depositAddress])
  @@index([merchantId])
  @@index([sessionId])
  @@map("quotes")
}

model Payment {
  id                    String        @id
  merchantId            String        @map("merchant_id")
  livemode              Boolean
  sessionId             String        @map("session_id")
  /// One payment per deposit address (quote).
  quoteId               String        @unique(map: "payments_quote_id_key") @map("quote_id")
  originTxHash          String?       @map("origin_tx_hash")
  amountReceived        Decimal       @map("amount_received") @db.Decimal(78, 0)
  settleTx              String?       @map("settle_tx")
  payoutTx              String?       @map("payout_tx")
  feeAmount             Decimal?      @map("fee_amount") @db.Decimal(78, 0)
  networkFee            Decimal?      @map("network_fee") @db.Decimal(78, 0)
  gasSponsored          Boolean       @default(false) @map("gas_sponsored")
  status                PaymentStatus @default(DETECTED)
  isLate                Boolean       @default(false) @map("is_late")
  senderAddress         String?       @map("sender_address")
  /// Every sender found (several for a multi-input Bitcoin deposit); each is screened.
  senderAddresses       String[]      @default([]) @map("sender_addresses")
  /// Origin transactions whose senders were resolved and screened; settlement needs all of them.
  senderOriginHashes    String[]      @default([]) @map("sender_origin_hashes")
  /// Refund reasons already recorded (`payment.refunded` and the return happen once per reason).
  refundsRecorded       String[]      @default([]) @map("refunds_recorded")
  senderChain           String?       @map("sender_chain")
  overpaidAmount        Decimal?      @map("overpaid_amount") @db.Decimal(78, 0)
  refundedAmount        Decimal?      @map("refunded_amount") @db.Decimal(78, 0)
  /// The last 1Click status seen for this payment's quote.
  oneclickStatus        String?       @map("oneclick_status")
  heldReason            HeldReason?   @map("held_reason")
  /// The overpayment was worth less than SMALL_OVERPAY_USD and stays with the merchant.
  keptSmallOverpayment  Boolean       @default(false) @map("kept_small_overpayment")
  amountOut             Decimal?      @map("amount_out") @db.Decimal(78, 0)
  amountInUsd           Decimal?      @map("amount_in_usd") @db.Decimal(18, 6)
  settledAt             DateTime?     @map("settled_at")
  /// How the settlement transfer (`settle_tx`; the claimed event is in `settlement_claims`) was verified:
  /// `receipt` (its transfer event) or `oneclick` (wallet payout to a chain without a verifier).
  verifiedBy            String?       @map("verified_by")
  /// Sanctions-screening retries done while SCREENING_PENDING.
  screeningAttempts     Int           @default(0) @map("screening_attempts")
  /// When the next screening retry is due; null = first retry (1 min after creation).
  screeningNextAt       DateTime?     @map("screening_next_at")
  /// Set when screening was still unavailable after 6 h: a merchant review item (not a hold).
  screeningUnresolvedAt DateTime?     @map("screening_unresolved_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  merchant                 Merchant          @relation(fields: [merchantId], references: [id])
  session                  Session           @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  quote                    Quote             @relation(fields: [quoteId, sessionId, merchantId, livemode], references: [id, sessionId, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  refunds                  Refund[]
  revenueEntries           RevenueEntry[]
  recoveredGasSponsorships GasSponsorship[]
  settlementClaims         SettlementClaim[]

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([sessionId])
  @@map("payments")
}

/// The destination transfer event that settled (or, for a late deposit, was returned for) a
/// payment. One event settles at most one payment (unique per tx, receipt and event); one
/// transaction may carry several (batched settlements).
model SettlementClaim {
  id         String   @id
  merchantId String   @map("merchant_id")
  livemode   Boolean
  paymentId  String   @unique @map("payment_id")
  txHash     String   @map("tx_hash")
  receiptId  String   @map("receipt_id")
  /// `<log index>.<data entry>.<token index>`, or `oneclick` for an unverified-chain payout.
  eventKey   String   @map("event_key")
  amount     Decimal  @db.Decimal(78, 0)
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([livemode, txHash, receiptId, eventKey], map: "settlement_claims_event_key")
  @@index([merchantId])
  @@map("settlement_claims")
}

model Refund {
  id                    String           @id
  merchantId            String           @map("merchant_id")
  livemode              Boolean
  paymentId             String           @map("payment_id")
  reason                RefundReason
  refundTxHash          String?          @map("refund_tx_hash")
  status                ExternalTxStatus @default(pending)
  /// The project 2 `refund` proposal that returns the money (null when 1Click refunds directly).
  proposalId            String?          @map("proposal_id")
  /// Where the money goes; null while `needs_address`.
  destination           String?          @map("destination")
  destinationChain      String?          @map("destination_chain")
  assetId               String           @map("asset_id")
  amount                Decimal          @db.Decimal(78, 0)
  /// The sender is a known exchange: no return address until the shopper gives one.
  needsAddress          Boolean          @default(false) @map("needs_address")
  /// A signer typed the legal-clearance acknowledgement (required to refund a held payment).
  acknowledgedLegalAt   DateTime?        @map("acknowledged_legal_at")
  /// Estimated cross-chain return fee deducted from the gross return (`amount` is net).
  returnFee             Decimal?         @map("return_fee") @db.Decimal(78, 0)
  /// Set when the return needs a person before a draft: `sanctions`, `needs_swap_route`,
  /// `price_unavailable` or `no_sender`.
  reviewReason          String?          @map("review_reason")
  /// sha256 (hex) of the single-use return-address token emailed to the shopper (Ruling C20).
  addressTokenHash      String?          @map("address_token_hash")
  addressTokenExpiresAt DateTime?        @map("address_token_expires_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  merchant Merchant         @relation(fields: [merchantId], references: [id])
  payment  Payment          @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  proposal AccountProposal? @relation(fields: [proposalId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  /// One return per payment and reason (the watcher hook and the sweeper are idempotent on it).
  @@unique([paymentId, reason])
  @@index([merchantId])
  @@index([paymentId])
  @@index([proposalId])
  @@map("refunds")
}

// ─── Delivery, gas & audit ──────────────────────────────────────────────────

model WebhookDelivery {
  id             String    @id
  merchantId     String    @map("merchant_id")
  livemode       Boolean
  endpointId     String    @map("endpoint_id")
  sessionId      String?   @map("session_id")
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  idempotencyKey String    @unique @map("idempotency_key")
  attempt        Int       @default(0)
  statusCode     Int?      @map("status_code")
  nextRetryAt    DateTime? @map("next_retry_at")
  /// pending (retrying) | delivered | failed (gave up after the retry window; resend still allowed)
  status         String    @default("pending")
  firstAttemptAt DateTime? @map("first_attempt_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  deliveredAt    DateTime? @map("delivered_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  endpoint WebhookEndpoint @relation(fields: [endpointId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  session  Session?        @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  event    Event           @relation(fields: [eventId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([endpointId])
  @@index([eventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model HookCall {
  id             String           @id
  merchantId     String           @map("merchant_id")
  livemode       Boolean
  sessionId      String           @map("session_id")
  chain          String
  targetContract String           @map("target_contract")
  txHash         String?          @map("tx_hash")
  attempt        Int              @default(0)
  status         ExternalTxStatus @default(pending)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  session  Session  @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([sessionId])
  @@map("hook_calls")
}

model GasSponsorship {
  id                     String            @id
  merchantId             String            @map("merchant_id")
  livemode               Boolean
  sessionId              String            @map("session_id")
  chain                  String
  txHash                 String?           @map("tx_hash")
  method                 SponsorshipMethod
  provider               String
  userOpHash             String?           @map("user_op_hash")
  sponsor                Sponsor
  gasUsed                Decimal?          @map("gas_used") @db.Decimal(78, 0)
  costUsd                Decimal?          @map("cost_usd") @db.Decimal(18, 6)
  recoveredFromPaymentId String?           @map("recovered_from_payment_id")
  status                 ExternalTxStatus  @default(pending)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  merchant             Merchant @relation(fields: [merchantId], references: [id])
  session              Session  @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)
  recoveredFromPayment Payment? @relation(fields: [recoveredFromPaymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([sessionId])
  @@map("gas_sponsorships")
}

model ScreeningResult {
  id         String            @id
  merchantId String            @map("merchant_id")
  livemode   Boolean
  sessionId  String            @map("session_id")
  address    String
  chain      String
  provider   String
  riskScore  Decimal           @map("risk_score") @db.Decimal(5, 2)
  decision   ScreeningDecision
  createdAt  DateTime          @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  session  Session  @relation(fields: [sessionId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([sessionId])
  @@map("screening_results")
}

/// Append-only (trigger `events_no_update`). merchant_id / livemode are null for system events.
model Event {
  id            String   @id
  merchantId    String?  @map("merchant_id")
  livemode      Boolean?
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  type          String
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  merchant   Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]
  outbox     EventOutbox?

  @@unique([id, merchantId, livemode])
  @@index([merchantId])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@map("events")
}

// ─── Revenue & branding ─────────────────────────────────────────────────────

model FeePlan {
  id              String   @id
  merchantId      String   @map("merchant_id")
  feeBps          Int      @map("fee_bps")
  defaultFeePayer FeePayer @map("default_fee_payer")
  volumeTiers     Json     @map("volume_tiers")
  effectiveFrom   DateTime @map("effective_from")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("fee_plans")
}

model RevenueEntry {
  id         String        @id
  merchantId String        @map("merchant_id")
  livemode   Boolean
  paymentId  String        @map("payment_id")
  source     RevenueSource
  assetId    String        @map("asset_id")
  amount     Decimal       @db.Decimal(78, 0)
  /// USD value at quote prices.
  amountUsd  Decimal?      @map("amount_usd") @db.Decimal(18, 6)
  txHash     String?       @map("tx_hash")
  createdAt  DateTime      @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId, merchantId, livemode], references: [id, merchantId, livemode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([paymentId, source])
  @@index([merchantId])
  @@index([paymentId])
  @@map("revenue_entries")
}

model CheckoutTheme {
  id               String      @id
  merchantId       String      @map("merchant_id")
  name             String
  isDefault        Boolean     @default(false) @map("is_default")
  version          Int         @default(1)
  status           ThemeStatus @default(draft)
  displayName      String      @map("display_name")
  logoUrl          String?     @map("logo_url")
  accent           String
  background       String
  text             String
  mode             ThemeMode   @default(auto)
  font             String
  cornerRadius     Int         @map("corner_radius")
  layout           ThemeLayout
  blocks           Json
  schemaVersion    Int         @map("schema_version")
  customCss        String?     @map("custom_css")
  cssHash          String?     @map("css_hash")
  cssValidation    Json?       @map("css_validation")
  buttonLabel      String?     @map("button_label")
  successMessage   String?     @map("success_message")
  supportUrl       String?     @map("support_url")
  termsUrl         String?     @map("terms_url")
  tokenPreferences Json        @map("token_preferences")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  assets       ThemeAsset[]
  paymentLinks PaymentLink[]
  sessions     Session[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@map("checkout_themes")
}

model ThemeAsset {
  id         String         @id
  merchantId String         @map("merchant_id")
  themeId    String         @map("theme_id")
  kind       ThemeAssetKind
  url        String
  mime       String
  sizeBytes  Int            @map("size_bytes")
  checksum   String
  createdAt  DateTime       @default(now()) @map("created_at")

  merchant Merchant      @relation(fields: [merchantId], references: [id])
  theme    CheckoutTheme @relation(fields: [themeId, merchantId], references: [id, merchantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId])
  @@index([themeId])
  @@map("theme_assets")
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

model IdempotencyKey {
  id           String            @id
  merchantId   String            @map("merchant_id")
  livemode     Boolean
  /// `${principal.kind}:${principalRef(principal)}`: keys are namespaced per credential, so one
  /// principal can never have another principal's stored response replayed.
  principalRef String            @map("principal_ref")
  key          String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(in_progress)
  lockedAt     DateTime          @map("locked_at")
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, livemode, principalRef, key])
  @@map("idempotency_keys")
}

/// KMS-envelope-encrypted secret (spec §5). `ciphertext` is the envelope JSON.
model Secret {
  id         String   @id
  purpose    String
  ciphertext String
  kek        String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  @@map("secrets")
}

model EventOutbox {
  id        String   @id
  eventId   String   @unique @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // The dispatcher reads the oldest rows first (ORDER BY created_at LIMIT 100).
  @@index([createdAt])
  @@map("event_outbox")
}
