{
  "name": "@tendr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src scripts prisma --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "kms:verify": "tsx scripts/verify-gcp-kms.ts",
    "jobs:failed": "tsx scripts/jobs-failed.ts",
    "e2e:serve": "tsx scripts/e2e-server.ts",
    "onchain:publish:testnet": "tsx scripts/onchain-publish-testnet.ts",
    "onchain:verify:mainnet": "tsx scripts/verify-merchant-account-mainnet.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@google-cloud/kms": "^6.3.0",
    "@near-js/crypto": "^2.5.1",
    "@near-js/providers": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@prisma/client": "^6.7.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tendr/contracts": "*",
    "bs58": "^6.0.0",
    "bullmq": "^6.3.12",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^6.0.0",
    "ulid": "^3.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tendr/config-eslint": "*",
    "@tendr/config-typescript": "*",
    "@types/node": "^22.15.3",
    "borsh": "^1.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.25.1",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
