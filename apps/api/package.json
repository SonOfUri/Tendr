{
  "name": "@tendr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:migrate:test": "tsx scripts/migrate-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@prisma/client": "^6.7.0",
    "@tendr/contracts": "*",
    "bs58": "^6.0.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "ulid": "^3.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tendr/config-eslint": "*",
    "@tendr/config-typescript": "*",
    "@types/node": "^22.15.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.25.1",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
