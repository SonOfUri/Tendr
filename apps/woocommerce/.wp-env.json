{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.1.3.zip",
  "phpVersion": "8.2",
  "port": 8890,
  "testsEnvironment": false,
  "plugins": ["https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip"],
  "mappings": {
    "wp-content/plugins/tendr-pay-with-crypto": "."
  },
  "config": {
    "TENDR_API_BASE": "http://host.docker.internal:4000",
    "TENDR_CHECKOUT_BASE": "http://localhost:3000"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp plugin activate tendr-pay-with-crypto && wp-env run cli wp rewrite structure '/%postname%/' --hard"
  }
}
