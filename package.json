{
  "name": "tendr",
  "private": true,
  "packageManager": "npm@10.9.4",
  "version": "0.1.0",
  "description": "Tendr \u2014 AI powered universal checkout and payment orchestration for digital commerce",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:console": "node scripts/dev-api-console.mjs",
    "dev:console:live": "node scripts/dev-live-console.mjs",
    "console:seed": "node scripts/dev-api-console.mjs --seed",
    "dev": "turbo run dev dev:worker --filter=@tendr/web --filter=@tendr/api",
    "dev:web": "turbo run dev --filter=@tendr/web",
    "dev:api": "turbo run dev dev:worker --filter=@tendr/api",
    "dev:docs": "npm run dev --workspace=@tendr/docs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=@tendr/web",
    "db:generate": "npm run db:generate --workspace=@tendr/api",
    "db:migrate": "npm run db:migrate --workspace=@tendr/api",
    "db:seed": "npm run db:seed --workspace=@tendr/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml,css}\"",
    "dev:wordpress": "node scripts/dev-wordpress.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.52.0"
  }
}
