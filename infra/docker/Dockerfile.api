FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN npm ci --include=dev \
    && npm run db:generate \
    && npx turbo run build --filter=@tendr/api...

# Keep tsx and Prisma for the API's pre-deploy migrations. Railway overrides CMD for the worker.
ENV NODE_ENV=production
USER node
EXPOSE 4000 4100
CMD ["npm", "run", "start", "--workspace=@tendr/api"]
