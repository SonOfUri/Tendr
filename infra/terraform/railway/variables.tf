# ---------------------------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------------------------

variable "workspace_id" {
  description = "Railway workspace (team) to create the project in; null for the personal workspace."
  type        = string
  default     = null
}

variable "project_name" {
  description = "Railway project name."
  type        = string
  default     = "tendr"
}

variable "source_repo" {
  description = "GitHub repository (owner/name) the api, worker and web services build from."
  type        = string
}

variable "source_repo_branch" {
  description = "Branch to deploy."
  type        = string
  default     = "main"
}

variable "region" {
  description = "Railway region for every service."
  type        = string
  default     = "us-east4-eqdc4a"
}

# ---------------------------------------------------------------------------------------------
# Hosts (shared). The custom domains are the host names of these URLs.
# ---------------------------------------------------------------------------------------------

variable "api_base_url" {
  description = "Public base URL of the API (API_BASE_URL, NEXT_PUBLIC_API_BASE_URL); its host is the api custom domain."
  type        = string
  default     = "https://api.usetendr.tech"

  validation {
    condition     = can(regex("^https://[^/:]+$", var.api_base_url))
    error_message = "api_base_url must be https://<host> with no path or trailing slash."
  }
}

variable "web_url" {
  description = "Public URL of the dashboard (WEB_URL); its host is the app custom domain."
  type        = string
  default     = "https://app.usetendr.tech"

  validation {
    condition     = can(regex("^https://[^/:]+$", var.web_url))
    error_message = "web_url must be https://<host> with no path or trailing slash."
  }
}

variable "checkout_base_url" {
  description = "Root of the pay host (CHECKOUT_BASE_URL, TENDR_CHECKOUT_BASE_URL); its host is the pay custom domain."
  type        = string
  default     = "https://pay.usetendr.tech"

  validation {
    condition     = can(regex("^https://[^/:]+$", var.checkout_base_url))
    error_message = "checkout_base_url must be https://<host> with no path or trailing slash."
  }
}

variable "cors_origins" {
  description = "Comma-separated allowed CORS origins (CORS_ORIGINS)."
  type        = string
  default     = "https://app.usetendr.tech"
}

variable "webauthn_rp_id" {
  description = "WebAuthn RP ID (WEBAUTHN_RP_ID, NEXT_PUBLIC_WEBAUTHN_RP_ID)."
  type        = string
  default     = "usetendr.tech"
}

variable "webauthn_origins" {
  description = "Comma-separated origins allowed in WebAuthn client data (WEBAUTHN_ORIGINS)."
  type        = string
  default     = "https://app.usetendr.tech"
}

variable "tendr_asset_origin" {
  description = "Public origin of theme assets (TENDR_ASSET_ORIGIN): https://storage.googleapis.com/<assets_bucket output of ../gcp>."
  type        = string
  default     = "https://storage.googleapis.com/tendr-assets-prod"
}

# ---------------------------------------------------------------------------------------------
# GCP / KMS (shared, api and worker only)
# ---------------------------------------------------------------------------------------------

variable "gcp_project_id" {
  description = "GCP project holding the key ring (GCP_PROJECT_ID)."
  type        = string
}

variable "gcp_kms_location" {
  description = "Cloud KMS location (GCP_KMS_LOCATION); `gcp_kms_location` output of ../gcp."
  type        = string
  default     = "us-east4"
}

variable "gcp_kms_keyring" {
  description = "Key ring name (GCP_KMS_KEYRING); `gcp_kms_keyring` output of ../gcp."
  type        = string
  default     = "tendr-prod"
}

variable "gcp_kms_kek" {
  description = "KEK name (GCP_KMS_KEK); `gcp_kms_kek` output of ../gcp."
  type        = string
  default     = "tendr-kek"
}

variable "gcp_credentials_json" {
  description = "JSON key of the tendr-api service account (GCP_CREDENTIALS_JSON); `api_credentials_json` output of ../gcp. Never commit it."
  type        = string
  sensitive   = true
}

# ---------------------------------------------------------------------------------------------
# api and worker
# ---------------------------------------------------------------------------------------------

variable "worker_health_port" {
  description = "Port of the worker's GET /health server (WORKER_HEALTH_PORT)."
  type        = number
  default     = 4100
}

variable "log_level" {
  description = "LOG_LEVEL for api and worker."
  type        = string
  default     = "info"
}

variable "database_app_password" {
  description = "Password of the tendr_app Postgres role (DATABASE_APP_PASSWORD). Null: generated by random_password. Must be URL-safe (it goes into DATABASE_URL unescaped)."
  type        = string
  sensitive   = true
  default     = null

  validation {
    condition     = var.database_app_password == null ? true : can(regex("^[A-Za-z0-9]{24,}$", var.database_app_password))
    error_message = "database_app_password must be at least 24 alphanumeric characters."
  }
}

variable "mail_from" {
  description = "From header of outgoing mail (MAIL_FROM)."
  type        = string
  default     = "Tendr <no-reply@usetendr.tech>"
}

variable "resend_api_key" {
  description = "Resend API key (RESEND_API_KEY)."
  type        = string
  sensitive   = true
}

variable "asset_s3_bucket" {
  description = "Asset bucket (ASSET_S3_BUCKET); `assets_bucket` output of ../gcp."
  type        = string
  default     = "tendr-assets-prod"
}

variable "asset_s3_access_key_id" {
  description = "HMAC access id (ASSET_S3_ACCESS_KEY_ID); `assets_hmac_access_id` output of ../gcp."
  type        = string
  sensitive   = true
}

variable "asset_s3_secret_access_key" {
  description = "HMAC secret (ASSET_S3_SECRET_ACCESS_KEY); `assets_hmac_secret` output of ../gcp."
  type        = string
  sensitive   = true
}

variable "oneclick_api_key" {
  description = "1Click JWT (ONECLICK_API_KEY); production refuses to boot without it."
  type        = string
  sensitive   = true
}

variable "fx_api_key" {
  description = "Open Exchange Rates app id (FX_API_KEY); production refuses to boot without it."
  type        = string
  sensitive   = true
}

# NEAR settings, empty until the accounts and the merchant-account code are published. Empty means
# "not set": the API then uses its defaults (tendr.near / tendr.testnet, fees.tendr.near /
# fees.tendr.testnet, no code hash).

variable "near_parent_account_live" {
  description = "NEAR_PARENT_ACCOUNT_LIVE; empty leaves the API default (tendr.near)."
  type        = string
  default     = ""
}

variable "near_parent_account_test" {
  description = "NEAR_PARENT_ACCOUNT_TEST; empty leaves the API default (tendr.testnet)."
  type        = string
  default     = ""
}

variable "fee_account_live" {
  description = "FEE_ACCOUNT_LIVE; empty leaves the API default (fees.tendr.near)."
  type        = string
  default     = ""
}

variable "fee_account_test" {
  description = "FEE_ACCOUNT_TEST; empty leaves the API default (fees.tendr.testnet)."
  type        = string
  default     = ""
}

variable "merchant_account_code_hash_live" {
  description = "MERCHANT_ACCOUNT_CODE_HASH_LIVE (base58), set once the audited wasm is published on mainnet."
  type        = string
  default     = ""
}

variable "merchant_account_code_hash_test" {
  description = "MERCHANT_ACCOUNT_CODE_HASH_TEST (base58), set once the wasm is published on testnet."
  type        = string
  default     = ""
}

# ---------------------------------------------------------------------------------------------
# web (build-time NEXT_PUBLIC_*; empty means unset, so the code's default applies)
# ---------------------------------------------------------------------------------------------

variable "next_public_reown_project_id" {
  description = "NEXT_PUBLIC_REOWN_PROJECT_ID; empty hides EVM, Solana and Bitcoin wallets in the checkout."
  type        = string
  default     = ""
}

variable "next_public_evm_forwarder_address" {
  description = "NEXT_PUBLIC_EVM_FORWARDER_ADDRESS; empty uses the shared default. Must equal the API's EVM_FORWARDER_ADDRESS."
  type        = string
  default     = ""
}

variable "next_public_tron_forwarder_address" {
  description = "NEXT_PUBLIC_TRON_FORWARDER_ADDRESS; empty turns gasless Tron off in the page."
  type        = string
  default     = ""
}

variable "next_public_gas_fee_recipients" {
  description = "NEXT_PUBLIC_GAS_FEE_RECIPIENTS, JSON { \"base\": \"0x…\", … }; empty means none pinned."
  type        = string
  default     = ""
}
