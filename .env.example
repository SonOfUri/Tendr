NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_PORT=4100
# WORKER_HEALTH_HOST=127.0.0.1  (default: 0.0.0.0 in production, 127.0.0.1 otherwise)
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tendr
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tendr_test
REDIS_URL=redis://localhost:6380
KEYVAULT_DRIVER=local
LOCAL_KEYVAULT_PATH=.keyvault/local.json
# Cloud KMS (KEYVAULT_DRIVER=gcp; required in production). Also used by `npm run kms:verify --workspace=@tendr/api`.
# GCP_PROJECT_ID=
# GCP_KMS_LOCATION=us-east4
# GCP_KMS_KEYRING=tendr
# GCP_KMS_KEK=tendr-kek
# GCP_CREDENTIALS_JSON={"type":"service_account",...}
# NEAR (merchant accounts). NEAR_CLIENT_DRIVER: fake = in-memory, no network (default outside
# production; refused in production); rpc = real node, signing with the key vault
# (funding-near creates accounts from the parent; relayer-accounts pays gas from its implicit account).
# NEAR_CLIENT_DRIVER=fake
# NEAR_RPC_URL_LIVE=https://rpc.mainnet.near.org
# NEAR_RPC_URL_TEST=https://rpc.testnet.near.org
# NEAR_PARENT_ACCOUNT_LIVE=tendr.near
# NEAR_PARENT_ACCOUNT_TEST=tendr.testnet
# INTENTS_CONTRACT_LIVE=intents.near
# INTENTS_CONTRACT_TEST=intents-mock.tendr.testnet
# base58 code hash of the published global merchant-account contract; provisioning is refused while unset.
# MERCHANT_ACCOUNT_CODE_HASH_LIVE=
# MERCHANT_ACCOUNT_CODE_HASH_TEST=
# funding-near spend caps, in yoctoNEAR (per mode): rolling 24 h total, and per new account.
# FUNDING_DAILY_CAP_YOCTO=50000000000000000000000000
# FUNDING_PER_ACCOUNT_YOCTO=1000000000000000000000000
# Seed (npm run db:seed): a real EVM payout address creates the Demo Merchant's live-mode
# settlement config. Unset = live payments stay disabled. The zero address is refused.
# SEED_PAYOUT_ADDRESS=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# If API_PORT is blocked by Windows excluded port ranges (EACCES), try e.g. 18080.
