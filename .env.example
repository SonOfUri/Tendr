NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_PORT=4100
# WORKER_HEALTH_HOST=127.0.0.1  (default: 0.0.0.0 in production, 127.0.0.1 otherwise)
API_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/tendr
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/tendr_test
# Production: DATABASE_URL is the least-privilege `tendr_app` role (api and worker); `npm run db:migrate`
# runs migrations and creates that role as the OWNER, using DATABASE_MIGRATE_URL (falls back to DATABASE_URL).
# DATABASE_APP_PASSWORD is the password db:migrate sets on `tendr_app` (left unchanged when unset).
# DATABASE_MIGRATE_URL=
# DATABASE_APP_PASSWORD=
REDIS_URL=redis://localhost:6380
# AI checkout assistant, merchant summaries and theme drafts. Model calls default off.
AI_PROVIDER=disabled
# For NEAR AI Cloud: AI_PROVIDER=near-ai and AI_MODEL=z-ai/glm-5.3-flash
# AI_BASE_URL=https://cloud-api.near.ai/v1  # selected automatically for near-ai
# AI_MODEL=z-ai/glm-5.3-flash
# NEARAI_API_KEY=<server-only NEAR key; alternatively KeyVault purpose near-ai>
# Generic alternative: AI_PROVIDER=openai-compatible, explicit AI_MODEL and optional AI_BASE_URL.
# AI_API_KEY=<generic provider credential; alternatively KeyVault purpose ai-provider>
AI_TIMEOUT_MS=20000
# Maximum model requests per UTC day shared across all features and live/test; failures count.
AI_DAILY_REQUEST_LIMIT=200
KEYVAULT_DRIVER=local
LOCAL_KEYVAULT_PATH=.keyvault/local.json
# Cloud KMS (KEYVAULT_DRIVER=gcp). Also used by `npm run kms:verify --workspace=@tendr/api`.
# GCP_PROJECT_ID=
# GCP_KMS_LOCATION=us-east4
# GCP_KMS_KEYRING=tendr
# GCP_KMS_KEK=tendr-kek
# GCP_CREDENTIALS_JSON={"type":"service_account",...}
# Temporary software vault (KEYVAULT_DRIVER=env). API and worker need the SAME complete bundle.
# Generate once with: node --import tsx apps/api/scripts/generate-env-keyvault.ts .keyvault/railway-keyvault.json
# ENV_KEYVAULT_JSON=<contents of the private bundle file, supplied as a secret variable>
# Keys reside in the application process. Keep a private backup; never regenerate on redeploy.
# To serve private S3/Railway bucket assets through the API:
# ASSET_PUBLIC_PROXY=true
# TENDR_ASSET_ORIGIN=https://api.usetendr.tech/v1/assets
# NEAR (merchant accounts). NEAR_CLIENT_DRIVER: fake = in-memory, no network (default outside
# production; refused in production); rpc = real node, signing with the key vault
# (funding-near creates accounts from the parent; relayer-accounts pays gas from its implicit account).
# NEAR_CLIENT_DRIVER=fake
# 1 = the fake runs an in-memory merchant-account contract, so proposals execute offline (dev, e2e).
# Only with NEAR_CLIENT_DRIVER=fake (refused otherwise); API unit tests always pin it off.
# NEAR_FAKE_SIMULATE=1
# New live stores: native passkey Intents wallets avoid custom contract deployment/funding.
# LIVE_ACCOUNT_DRIVER=native_intents
# NEAR_RPC_URL_LIVE=https://rpc.mainnet.near.org
# NEAR_RPC_URL_TEST=https://rpc.testnet.near.org
# NEAR_PARENT_ACCOUNT_LIVE=tendr.near
# NEAR_PARENT_ACCOUNT_TEST=tendr.testnet
# INTENTS_CONTRACT_LIVE=intents.near
# INTENTS_CONTRACT_TEST=intents-mock.tendr.testnet
# base58 code hash of the published global merchant-account contract; provisioning is refused while unset.
# MERCHANT_ACCOUNT_CODE_HASH_LIVE=
# MERCHANT_ACCOUNT_CODE_HASH_TEST=
# funding-near spend caps, in yoctoNEAR (per mode): rolling 24 h total, and per new account.
# FUNDING_DAILY_CAP_YOCTO=50000000000000000000000000
# FUNDING_PER_ACCOUNT_YOCTO=1000000000000000000000000
# yoctoNEAR each new merchant account is seeded with (storage); must fit the per-account cap.
# MERCHANT_ACCOUNT_INITIAL_BALANCE_YOCTO=500000000000000000000000
# yoctoNEAR one storage top-up sends when an account's free balance runs low (counts against the
# daily cap; must fit the per-account cap).
# MERCHANT_ACCOUNT_STORAGE_TOPUP_YOCTO=500000000000000000000000
# Dashboard auth. Passkeys belong to the RP ID; production uses usetendr.tech (required there,
# along with https origins). WEBAUTHN_ORIGINS is a comma list of dashboard origins.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Tendr
# WEBAUTHN_ORIGINS=http://localhost:3000
# Mail: log (dev default: writes apps/api/.mail/*.json), memory (tests), resend (production
# default: needs RESEND_API_KEY), unconfigured (sending fails).
# MAIL_DRIVER=log
# Resend API key (a secret: env only, never committed). Required when MAIL_DRIVER is resend.
# RESEND_API_KEY=
# The From header of every outgoing mail.
# MAIL_FROM=Tendr <no-reply@usetendr.tech>
# 1Click (checkout swaps, live mode; test mode uses the simulated provider and never calls 1Click).
# ONECLICK_API_KEY is the 1Click JWT (sent as X-API-Key); required in production.
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# ONECLICK_API_KEY=
# Tendr's fee account per mode (the 1Click appFees recipient); must be valid NEAR account ids.
# FEE_ACCOUNT_LIVE=fees.tendr.near
# FEE_ACCOUNT_TEST=fees.tendr.testnet
# Checkout quote slippage tolerance (bps, default 100) and the default gas-reimbursement cap in USD
# used when a session or payment link sets no gas_max_usd (default 2).
# CHECKOUT_SLIPPAGE_BPS=100
# CHECKOUT_GAS_MAX_USD=2
# Tendr-wide daily cap (USD, per mode, UTC day) on unrecovered gas-sponsorship losses; once
# reached, new payments fall back to "shopper pays" and operators are alerted (default 50).
# TENDR_SPONSOR_LOSS_CAP_USD=50
# Underpay top-up offer ("send the remaining X to the same address" while the quote is live).
# Unset: on in test mode, off in live mode (until the mainnet check confirms 1Click accumulates
# top-ups). Set true/false to force it for both modes.
# CHECKOUT_TOPUP_ENABLED=
# Live-mode EVM RPCs for reading a deposit's sender (sanctions screening), JSON by 1Click chain id,
# merged over public defaults (eth, base, arb, pol, bsc, op, avax). Example:
# EVM_RPC_URLS={"eth":"https://eth.example/rpc","arbitrum":"https://arb.example/rpc"}
# Live-mode Solana and Tron endpoints (sender lookups, network-fee estimates).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# TRON_RPC_URL=https://api.trongrid.io
# Gasless Tron (project 5a): the TendrForwarder deployed on Tron (base58 T…). No default: gasless
# Tron USDT is unavailable until it is set.
# TRON_FORWARDER_ADDRESS=
# Safety margin on network fees Tendr quotes (basis points, default 2000 = 20%).
# GAS_FEE_MARGIN_BPS=2000
# Live-mode switch. Off (false) until the merchant-account contract is audited: no store goes
# live, no mainnet merchant account is provisioned, and every write in live mode (a live key, a
# dashboard request in live mode, a live connection) is refused with 403 LIVE_MODE_UNAVAILABLE.
# Live reads and test mode work as usual.
# LIVE_MODE_ENABLED=false
# Gasless (sponsored) payments in live mode. Off (false) until the TendrForwarder is externally
# reviewed: the checkout then offers no sponsored option in live mode. Test mode's simulated
# gasless is unaffected.
# GASLESS_LIVE_ENABLED=false
# Gas-fee sweep (live mode only): each gas-fee account's token is swapped through 1Click into USDC
# on NEAR, credited to TENDR_FEE_ACCOUNT_NEAR, once worth FEE_SWEEP_THRESHOLD_USD or weekly. Off
# until FEE_SWEEP_ENABLED=true (plans are only recorded and announced to operators). Relayer keys
# and the Pimlico balance below GAS_LOW_BALANCE_USD alert operators (once per 6 h per account).
# FEE_SWEEP_ENABLED=false
# FEE_SWEEP_THRESHOLD_USD=20
# TENDR_FEE_ACCOUNT_NEAR=
# GAS_LOW_BALANCE_USD=50
# EVM gasless relayer (project 5a): the TendrForwarder address (same CREATE2 address on every EVM
# chain; default below) and optional per-chain caps on the relayer's maxFeePerGas, in gwei
# (EVM_MAX_FEE_GWEI_ETH, _BASE, _ARB, _OP, _POL, _BSC, _AVAX, _GNOSIS, _BERA).
# EVM_FORWARDER_ADDRESS=0x19BEBC71495490A99cA6F50F107076967380cf09
# EVM_MAX_FEE_GWEI_ETH=80
# Pimlico paymaster proxy (smart wallets, EIP-5792 paymasterService): optional sponsorship policy
# id sent with each request. The Pimlico API key is a stored secret (putSecret purpose `pimlico`),
# never set here.
# PIMLICO_SPONSORSHIP_POLICY_ID=sp_example
# Pimlico Solana paymaster (Kora) network: mainnet (default) or devnet. Live mode only.
# PIMLICO_SOLANA_NETWORK=mainnet
# FX for non-USD order totals (converted to USD once, at session creation). Rates read
# "1 USD = R <code>". Live mode uses FX_PROVIDER=openexchangerates with FX_API_KEY (the Open
# Exchange Rates app id; required in production); FX_PROVIDER=fixed (the default outside
# production; refused in production) means no live provider, so live non-USD sessions get 503.
# Live mode never uses fixed rates. Test mode always uses built-in test rates; FX_FIXED_RATES
# (JSON of code to decimal string, strings not numbers) overrides entries.
# FX_PROVIDER=fixed
# FX_API_KEY=
# FX_FIXED_RATES={"NGN":"1602.04","EUR":"0.92","JPY":"151.5"}
# Base URL of the hosted checkout page (a session's url is <base>/<id>#cs=<client_secret>).
# CHECKOUT_BASE_URL=http://localhost:3000
# Shared secret the web server (apps/web) sends as x-tendr-internal when it reads public payment
# links for a payer, so the API can key per-IP limits on the payer's IP (x-tendr-client-ip).
# Unset = the header is never trusted. Required in production, at least 32 characters; the same
# value goes in both apps. Generate with: openssl rand -hex 32
# WEB_INTERNAL_TOKEN=
# The origin theme assets are served from. API: custom theme CSS/HTML may load images and fonts
# from it only (unset = http://localhost:9100/tendr-assets). Web server: the one origin a
# payment-link preview card may fetch a merchant logo from (https, no redirects, 1 MB, 3 s);
# unset = the card always draws the merchant's initial. Must be https in production.
TENDR_ASSET_ORIGIN=http://localhost:9100/tendr-assets
# Theme asset storage (API). s3 = any S3-compatible bucket (MinIO from infra/docker locally; R2 or
# S3 in production, required there, with an https TENDR_ASSET_ORIGIN); memory = tests (the
# default outside production). The bucket must be publicly readable at TENDR_ASSET_ORIGIN.
# memory keeps uploads only until the API restarts. To use MinIO, run
# `docker compose -f infra/docker/docker-compose.yml up -d minio minio-init` and uncomment the
# s3 block below.
ASSET_STORE_DRIVER=memory
# ASSET_STORE_DRIVER=s3
# ASSET_S3_ENDPOINT=http://localhost:9100
# Default auto (R2); MinIO accepts any region.
# ASSET_S3_REGION=auto
# ASSET_S3_BUCKET=tendr-assets
# ASSET_S3_ACCESS_KEY_ID=tendr-minio
# ASSET_S3_SECRET_ACCESS_KEY=tendr-minio-secret
# true for MinIO (bucket in the path); false for R2/S3 virtual-hosted buckets.
# ASSET_S3_FORCE_PATH_STYLE=true
# Google Cloud Storage (production, and the local dev bucket) through its S3-compatible interop:
# a public bucket plus an HMAC key pair (placeholders below, never commit real values). Use this
# block instead of the MinIO one above.
# ASSET_STORE_DRIVER=s3
# ASSET_S3_ENDPOINT=https://storage.googleapis.com
# ASSET_S3_REGION=auto
# ASSET_S3_FORCE_PATH_STYLE=true
# ASSET_S3_BUCKET=tendr-assets-dev
# ASSET_S3_ACCESS_KEY_ID=<hmac-access-id>
# ASSET_S3_SECRET_ACCESS_KEY=<hmac-secret>
# TENDR_ASSET_ORIGIN=https://storage.googleapis.com/tendr-assets-dev
# The checkout origin baked into tendr.js (the store embed, apps/web/scripts/build-embed.mjs):
# it frames and listens only to this origin, so it must be the same origin as CHECKOUT_BASE_URL.
# Unset = CHECKOUT_BASE_URL, else https://usetendr.tech. Part of the web build's cache key.
# TENDR_CHECKOUT_BASE_URL=
# Seed (npm run db:seed): a real EVM payout address creates the Demo Merchant's live-mode
# settlement config. Unset = live payments stay disabled. The zero address is refused.
# SEED_PAYOUT_ADDRESS=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Dextools trial key for dashboard token logos the icon CDN does not have.
# Read only by the web server (apps/web/.env.local). Never a NEXT_PUBLIC_ variable.
# DEXTOOLS_API_KEY=
# Dashboard passkey RP ID for signing ceremonies (usetendr.tech in production). Unset = page host.
# NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
# Reown (WalletConnect) project id for the checkout's "Connect wallet" (EVM, Solana, Bitcoin).
# Unset = those wallets are hidden and shoppers send manually (Tron and NEAR wallets still work).
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# Gasless payments: the pay page only lets a wallet approve Tendr's own forwarder. Must equal the
# API's EVM_FORWARDER_ADDRESS / TRON_FORWARDER_ADDRESS. Unset Tron forwarder = Tron wallets send
# normally (pay the fee in TRX).
# NEXT_PUBLIC_EVM_FORWARDER_ADDRESS=0x19BEBC71495490A99cA6F50F107076967380cf09
# NEXT_PUBLIC_TRON_FORWARDER_ADDRESS=
# Tendr's gas-fee accounts per chain (the public gas-fees-* addresses), JSON chain -> address.
# Live gasless payments on a chain need it pinned; the API's fee_recipient must match.
# NEXT_PUBLIC_GAS_FEE_RECIPIENTS={"base":"0x...","sol":"...","tron":"T...","near":"..."}
# If API_PORT is blocked by Windows excluded port ranges (EACCES), try e.g. 18080.

# Local API console (/settings/api-console) and local mail inbox (/settings/local-mail).
# Unset: enabled only when NODE_ENV=development. Set true to force on, false to force off.
# API_CONSOLE_ENABLED=true
# NEXT_PUBLIC_API_CONSOLE_ENABLED=true
# API_CONSOLE_WEB_PORT=3300
# API_CONSOLE_API_PORT=4300
# Start with: npm run dev:console  (docs/api-console.md)

# Test-mode sanctions screening: comma-separated blocked addresses (no HTTP in test mode).
# Live mode uses the stored secret with purpose "chainalysis", falling back to the env key below.
# SCREENING_TEST_BLOCKLIST=0x000000000000000000000000000000000000dead
# CHAINALYSIS_API_KEY=  # optional fallback; an encrypted stored chainalysis secret takes precedence
# Live screening: chainalysis (default, fail closed) or disabled (explicitly audited as skipped).
# Set the same value on API and worker. Test-mode blocklist remains active in either mode.
# SCREENING_MODE=chainalysis
