{
  "name": "@usetendr/sdk",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/esm/webhook.d.ts",
        "default": "./dist/esm/webhook.js"
      },
      "require": {
        "types": "./dist/cjs/webhook.d.ts",
        "default": "./dist/cjs/webhook.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "generate:types": "node scripts/generate-types.mjs",
    "check:contracts": "node scripts/generate-types.mjs --check",
    "test:package": "node scripts/test-package.mjs",
    "check:api-types": "tsc -p tsconfig.contracts.json"
  },
  "devDependencies": {
    "@tendr/config-eslint": "*",
    "@tendr/config-typescript": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "description": "Typed server-side TypeScript and JavaScript SDK for Tendr payments",
  "module": "./dist/esm/index.js",
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonOfUri/Tendr.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.usetendr.tech/sdks/typescript",
  "publishConfig": {
    "access": "public"
  }
}
